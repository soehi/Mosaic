<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Mosaic" Manufacturer="Mosaic" Version="$(ProductVersion)" UpgradeCode="{4D2B073C-72D5-4C3A-B845-65FC2C52D23C}" Scope="perUser" Language="2052" Codepage="65001">
    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的 Mosaic。" Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="WINDOWSBUILD"><RegistrySearch Id="WindowsBuildNumber" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64"/></Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSBUILD &gt;= 19041)" Message="Mosaic 需要 64 位 Windows 10 2004 或更高版本。" />
    <StandardDirectory Id="LocalAppDataFolder"><Directory Id="UserPrograms" Name="Programs"><Directory Id="INSTALLFOLDER" Name="Mosaic" /></Directory></StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"><Directory Id="MosaicMenu" Name="Mosaic">
      <Component Id="StartMenu" Guid="{EE2D7997-D220-49B1-9DDC-90C9C61F2FC8}">
        <Shortcut Id="StartMosaic" Name="Mosaic" Target="[INSTALLFOLDER]Mosaic.Desktop.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveMosaicMenu" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Mosaic\Installer" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Directory></StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="{A6C6D7B3-F223-4B32-A6B1-86571AC73693}">
        <Shortcut Id="DesktopMosaic" Name="Mosaic" Target="[INSTALLFOLDER]Mosaic.Desktop.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Mosaic\Installer" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <!-- 仅在完整卸载时清理本工作区写入的登录启动项；升级走 MajorUpgrade，安装中检测到旧版本时跳过清理。 -->
    <Component Id="StartupCleanup" Guid="{7F1A2B93-3A11-4E6C-9A2B-2D1F0C7A6E55}" Directory="INSTALLFOLDER" Condition="NOT WIX_UPGRADE_DETECTED">
      <RegistryValue Root="HKCU" Key="Software\Mosaic\Startup" Name="DataRoot" Type="string" Value="" KeyPath="yes" />
      <RemoveRegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Mosaic" Id="RemoveStartupRun" />
      <RemoveRegistryValue Root="HKCU" Key="Software\Mosaic\Startup" Name="DataRoot" Id="RemoveStartupOwnership" />
    </Component>
    <Feature Id="Application" Title="Mosaic" Level="1"><ComponentGroupRef Id="Payload"/><ComponentRef Id="StartMenu"/><ComponentRef Id="DesktopShortcut"/><ComponentRef Id="StartupCleanup"/></Feature>
  </Package>
</Wix>
