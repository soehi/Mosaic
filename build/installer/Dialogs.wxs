<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--
    安装界面：首次安装（位置选择 + 确认）、同版本维护（自动扫描 + 按需修复）、升级继承位置。
    对话框由 Package.wxs 的 InstallUISequence 按 MOSAICSTATE 选择显示；所有文本为简体中文。
  -->
  <Fragment>
    <UI Id="MosaicUI">
      <TextStyle Id="MosaicFont" FaceName="Microsoft YaHei UI" Size="9" />
      <TextStyle Id="MosaicFontBold" FaceName="Microsoft YaHei UI" Size="12" Bold="yes" />
      <TextStyle Id="MosaicFontSmall" FaceName="Microsoft YaHei UI" Size="8" />

      <Dialog Id="FreshStartDlg" Width="370" Height="270" Title="Mosaic 安装程序" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="24" Transparent="yes" NoPrefix="yes" Text="{\MosaicFontBold}安装 Mosaic" />
        <Control Id="Intro" Type="Text" X="15" Y="50" Width="340" Height="40" Transparent="yes" NoPrefix="yes" Text="{\MosaicFont}安装程序会把 Mosaic 安装到当前用户，不会修改系统级设置。" />
        <Control Id="Hint" Type="Text" X="15" Y="95" Width="340" Height="60" Transparent="yes" NoPrefix="yes" Text="{\MosaicFont}下一步可以选择安装位置。默认位置为当前用户的应用目录；用户数据保存在单独的数据目录中，升级和修复不会改动数据。" />
        <Control Id="Version" Type="Text" X="15" Y="225" Width="250" Height="15" Transparent="yes" NoPrefix="yes" Text="{\MosaicFontSmall}版本 [ProductVersion]" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="下一步">
          <Publish Event="NewDialog" Value="LocationDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="LocationDlg" Width="370" Height="270" Title="Mosaic 安装程序" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="24" Transparent="yes" NoPrefix="yes" Text="{\MosaicFontBold}选择安装位置" />
        <Control Id="PathLabel" Type="Text" X="15" Y="50" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\MosaicFont}安装文件夹：" />
        <Control Id="Path" Type="PathEdit" X="15" Y="68" Width="340" Height="18" Property="MOSAICINSTALLPATH" Text="[MOSAICINSTALLPATH]" />
        <Control Id="Browse" Type="PushButton" X="15" Y="92" Width="70" Height="17" Text="浏览...">
          <Publish Event="DoAction" Value="BrowseInstallFolder" />
          <Publish Event="NewDialog" Value="LocationDlg" />
        </Control>
        <Control Id="Restore" Type="PushButton" X="90" Y="92" Width="80" Height="17" Text="恢复默认">
          <Publish Event="DoAction" Value="RestoreDefaultInstallFolder" />
          <Publish Event="NewDialog" Value="LocationDlg" />
        </Control>
        <Control Id="CurrentLabel" Type="Text" X="15" Y="120" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\MosaicFont}当前目标：" />
        <Control Id="CurrentPath" Type="Text" X="15" Y="138" Width="340" Height="30" Transparent="yes" NoPrefix="yes" Text="[MOSAICINSTALLPATH]" />
        <Control Id="ErrorText" Type="Text" X="15" Y="168" Width="340" Height="45" Transparent="yes" NoPrefix="yes" Text="[MOSAICPATHERROR]" />
        <Control Id="Hint" Type="Text" X="15" Y="225" Width="250" Height="15" Transparent="yes" NoPrefix="yes" Text="{\MosaicFontSmall}安装位置不能与用户数据目录重叠。" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="上一步">
          <Publish Event="NewDialog" Value="FreshStartDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="下一步">
          <Publish Event="DoAction" Value="ValidateInstallFolder" />
          <Publish Event="NewDialog" Value="ConfirmDlg" Condition="MOSAICPATHERROR = &quot;&quot;" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="ConfirmDlg" Width="370" Height="270" Title="Mosaic 安装程序" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="24" Transparent="yes" NoPrefix="yes" Text="{\MosaicFontBold}确认安装" />
        <Control Id="TargetLabel" Type="Text" X="15" Y="50" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\MosaicFont}Mosaic 将安装到：" />
        <Control Id="Target" Type="Text" X="15" Y="68" Width="340" Height="30" Transparent="yes" NoPrefix="yes" Text="[INSTALLFOLDER]" />
        <Control Id="Hint" Type="Text" X="15" Y="110" Width="340" Height="60" Transparent="yes" NoPrefix="yes" Text="{\MosaicFont}同时会创建桌面和开始菜单快捷方式。安装完成后不会自动启动程序。" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="上一步">
          <Publish Event="NewDialog" Value="LocationDlg" />
        </Control>
        <Control Id="Install" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="安装">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="MaintStartDlg" Width="370" Height="270" Title="Mosaic 维护" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="24" Transparent="yes" NoPrefix="yes" Text="{\MosaicFontBold}Mosaic 已安装" />
        <Control Id="Version" Type="Text" X="15" Y="50" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\MosaicFont}已安装版本：[MOSAICINSTALLEDVERSION]" />
        <Control Id="LocationLabel" Type="Text" X="15" Y="70" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\MosaicFont}安装位置：" />
        <Control Id="Location" Type="Text" X="15" Y="88" Width="340" Height="30" Transparent="yes" NoPrefix="yes" Text="[MOSAICINSTALLEDLOCATION]" />
        <Control Id="Hint" Type="Text" X="15" Y="128" Width="340" Height="45" Transparent="yes" NoPrefix="yes" Text="{\MosaicFont}下一步会检查安装文件是否完整。检查只读取文件，不会改动 Mosaic 的程序和你的数据。" />
        <Control Id="Message" Type="Text" X="15" Y="178" Width="340" Height="35" Transparent="yes" NoPrefix="yes" Text="[MOSAICSTATUSMESSAGE]" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="下一步">
          <Publish Event="DoAction" Value="ScanPayload" Condition="NOT MOSAICLOCATIONMISSING" />
          <Publish Event="NewDialog" Value="MaintenanceDlg" Condition="NOT MOSAICLOCATIONMISSING" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="关闭">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="MaintenanceDlg" Width="370" Height="270" Title="Mosaic 维护" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="24" Transparent="yes" NoPrefix="yes" Text="{\MosaicFontBold}完整性检查" />
        <Control Id="Summary" Type="Text" X="15" Y="50" Width="340" Height="30" Transparent="yes" NoPrefix="yes" Text="[MOSAICSCANSUMMARY]" />
        <Control Id="Detail" Type="Text" X="15" Y="85" Width="340" Height="60" Transparent="yes" NoPrefix="yes" Text="[MOSAICSCANDETAIL]" />
        <Control Id="Counts" Type="Text" X="15" Y="150" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\MosaicFontSmall}已检查 [MOSAICSCANCHECKED] 个文件：缺失 [MOSAICSCANMISSING]，损坏 [MOSAICSCANDAMAGED]，无法检查 [MOSAICSCANERROR]。" />
        <Control Id="ResultHint" Type="Text" X="15" Y="178" Width="340" Height="45" Transparent="yes" NoPrefix="yes" Text="{\MosaicFont}未发现缺失或损坏时直接完成，不会重装、不会关闭正在运行的 Mosaic。发现异常时下一步会使用安装包中的文件修复，用户数据不受影响。" />
        <Control Id="Rescan" Type="PushButton" X="15" Y="243" Width="80" Height="17" Text="重新检查">
          <Publish Event="DoAction" Value="ScanPayload" />
          <Publish Event="NewDialog" Value="MaintenanceDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="下一步">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Close" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="关闭">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="UpgradeDlg" Width="370" Height="270" Title="Mosaic 安装程序" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="24" Transparent="yes" NoPrefix="yes" Text="{\MosaicFontBold}升级 Mosaic" />
        <Control Id="Version" Type="Text" X="15" Y="50" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\MosaicFont}[MOSAICINSTALLEDVERSION] 将升级到 [ProductVersion]。" />
        <Control Id="LocationLabel" Type="Text" X="15" Y="72" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\MosaicFont}安装位置保持不变：" />
        <Control Id="Location" Type="Text" X="15" Y="90" Width="340" Height="30" Transparent="yes" NoPrefix="yes" Text="[MOSAICINSTALLEDLOCATION]" />
        <Control Id="Hint" Type="Text" X="15" Y="130" Width="340" Height="60" Transparent="yes" NoPrefix="yes" Text="{\MosaicFont}升级会替换程序文件，保留用户数据、配置和备份。升级过程中请不要关闭安装程序。" />
        <Control Id="Install" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="升级">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="BlockedDlg" Width="370" Height="270" Title="Mosaic 安装程序" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="24" Transparent="yes" NoPrefix="yes" Text="{\MosaicFontBold}无法继续安装" />
        <Control Id="Reason" Type="Text" X="15" Y="50" Width="340" Height="100" Transparent="yes" NoPrefix="yes" Text="[MOSAICSTATEERROR]" />
        <Control Id="Hint" Type="Text" X="15" Y="158" Width="340" Height="60" Transparent="yes" NoPrefix="yes" Text="{\MosaicFont}为了避免误修复或重复安装，安装已停止。请使用与已安装版本匹配的安装包，或先在「应用和功能」中卸载现有 Mosaic。" />
        <Control Id="Close" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="关闭">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="UnknownDlg" Width="370" Height="270" Title="Mosaic 安装程序" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="24" Transparent="yes" NoPrefix="yes" Text="{\MosaicFontBold}无法检测已安装的 Mosaic" />
        <Control Id="Reason" Type="Text" X="15" Y="50" Width="340" Height="100" Transparent="yes" NoPrefix="yes" Text="[MOSAICSTATEERROR]" />
        <Control Id="Hint" Type="Text" X="15" Y="158" Width="340" Height="60" Transparent="yes" NoPrefix="yes" Text="{\MosaicFont}无法确认当前安装状态时不会执行修复或覆盖安装。请稍后重试，或先在「应用和功能」中检查现有 Mosaic。" />
        <Control Id="Close" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="关闭">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="ProgressDlg" Width="370" Height="270" Title="Mosaic 安装程序" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="24" Transparent="yes" NoPrefix="yes" Text="{\MosaicFontBold}正在处理，请稍候..." />
        <Control Id="ActionText" Type="Text" X="15" Y="50" Width="340" Height="30" Transparent="yes" NoPrefix="yes" Text="[ActionText]" />
        <Control Id="ProgressBar" Type="ProgressBar" X="15" Y="210" Width="340" Height="15" ProgressBlocks="yes" Text="正在安装..." />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="Exit" Width="370" Height="270" Title="Mosaic 安装程序" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="24" Transparent="yes" NoPrefix="yes" Text="{\MosaicFontBold}操作已完成" />
        <Control Id="Summary" Type="Text" X="15" Y="50" Width="340" Height="30" Transparent="yes" NoPrefix="yes" Text="[MOSAICSCANSUMMARY]" />
        <Control Id="VerifyMessage" Type="Text" X="15" Y="88" Width="340" Height="60" Transparent="yes" NoPrefix="yes" Text="[MOSAICVERIFYMESSAGE]" />
        <Control Id="VerifySummary" Type="Text" X="15" Y="155" Width="340" Height="45" Transparent="yes" NoPrefix="yes" Text="[MOSAICVERIFYSUMMARY]" />
        <Control Id="Hint" Type="Text" X="15" Y="205" Width="340" Height="30" Transparent="yes" NoPrefix="yes" Text="{\MosaicFontSmall}安装或维护已完成，程序文件和快捷方式保持可用；用户数据和配置没有被改动。" />
        <Control Id="Finish" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="完成">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="FatalError" Width="370" Height="270" Title="Mosaic 安装程序" NoMinimize="yes" ErrorDialog="yes">
        <Control Id="ErrorText" Type="Text" X="15" Y="50" Width="340" Height="120" Transparent="yes" NoPrefix="yes" TabSkip="no" Text="[ErrorText]" />
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="24" Transparent="yes" NoPrefix="yes" Text="{\MosaicFontBold}安装未完成" />
        <Control Id="Hint" Type="Text" X="15" Y="178" Width="340" Height="45" Transparent="yes" NoPrefix="yes" Text="{\MosaicFont}已完成的步骤会回滚。请关闭正在使用 Mosaic 文件的程序后重新运行安装包；需要时重启电脑再试。" />
        <Control Id="ErrorYes" Type="PushButton" X="15" Y="243" Width="48" Height="17" Text="是">
          <Publish Event="EndDialog" Value="ErrorYes" />
        </Control>
        <Control Id="ErrorNo" Type="PushButton" X="65" Y="243" Width="48" Height="17" Text="否">
          <Publish Event="EndDialog" Value="ErrorNo" />
        </Control>
        <Control Id="ErrorOk" Type="PushButton" X="115" Y="243" Width="48" Height="17" Default="yes" Cancel="yes" Text="确定">
          <Publish Event="EndDialog" Value="ErrorOk" />
        </Control>
        <Control Id="ErrorCancel" Type="PushButton" X="165" Y="243" Width="48" Height="17" Text="取消">
          <Publish Event="EndDialog" Value="ErrorCancel" />
        </Control>
        <Control Id="ErrorRetry" Type="PushButton" X="215" Y="243" Width="48" Height="17" Text="重试">
          <Publish Event="EndDialog" Value="ErrorRetry" />
        </Control>
        <Control Id="ErrorIgnore" Type="PushButton" X="265" Y="243" Width="48" Height="17" Text="忽略">
          <Publish Event="EndDialog" Value="ErrorIgnore" />
        </Control>
        <Control Id="ErrorAbort" Type="PushButton" X="315" Y="243" Width="48" Height="17" Text="中止">
          <Publish Event="EndDialog" Value="ErrorAbort" />
        </Control>
      </Dialog>

      <Dialog Id="UserExit" Width="370" Height="270" Title="Mosaic 安装程序" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="24" Transparent="yes" NoPrefix="yes" Text="{\MosaicFontBold}安装已取消" />
        <Control Id="Message" Type="Text" X="15" Y="50" Width="340" Height="60" Transparent="yes" NoPrefix="yes" Text="{\MosaicFont}安装程序已退出，未完成的操作已回滚，Mosaic 的用户数据没有被改动。" />
        <Control Id="Close" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="关闭">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="FilesInUse" Width="370" Height="270" Title="Mosaic 安装程序" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="24" Transparent="yes" NoPrefix="yes" Text="{\MosaicFontBold}Mosaic 正在运行" />
        <Control Id="Message" Type="Text" X="15" Y="50" Width="340" Height="45" Transparent="yes" NoPrefix="yes" Text="{\MosaicFont}以下程序正在使用需要更新或修复的文件。关闭这些程序后点击「重试」。" />
        <Control Id="FileList" Type="ListBox" X="15" Y="100" Width="340" Height="90" Property="FileInUseProcess" Sunken="yes" Sorted="yes" />
        <Control Id="Retry" Type="PushButton" X="180" Y="243" Width="56" Height="17" Default="yes" Text="重试">
          <Publish Event="EndDialog" Value="Retry" />
        </Control>
        <Control Id="Ignore" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="忽略">
          <Publish Event="EndDialog" Value="Ignore" />
        </Control>
        <Control Id="Exit" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="退出">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>