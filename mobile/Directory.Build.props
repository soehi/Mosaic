<Project>
  <!--
    The mobile tree owns its build settings. This file stops the repository-root
    Directory.Build.props from applying desktop versioning and lock files to the
    Android target, while keeping the same language and warning standards.
    Mobile versioning is independent of the desktop 0.18.x line.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <UseSharedCompilation>false</UseSharedCompilation>
    <Version>0.3.2</Version>
    <Authors>Mosaic</Authors>
    <Product>Mosaic Mobile</Product>
  </PropertyGroup>
</Project>
