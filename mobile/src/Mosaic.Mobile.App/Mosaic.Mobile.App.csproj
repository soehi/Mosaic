<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Mosaic.Mobile.App</RootNamespace>
    <AssemblyName>Mosaic.Mobile.App</AssemblyName>
    <Description>Headless Android host: desktop widget, its receivers and the widget reconfigure dialog.</Description>

    <!-- Same store package as 0.2.x so an install upgrades in place; versionCode 4 was 0.2.1. -->
    <ApplicationId>app.mosaic.tasks</ApplicationId>
    <ApplicationDisplayVersion>0.3.6</ApplicationDisplayVersion>
    <ApplicationVersion>11</ApplicationVersion>

    <MosaicMobileAppLinkHost Condition="'$(MosaicMobileAppLinkHost)' == ''">mosaic.bansonic.top</MosaicMobileAppLinkHost>
    <AndroidManifestPlaceholders>mosaicAppLinkHost=$(MosaicMobileAppLinkHost)</AndroidManifestPlaceholders>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Trimming stays on: with PublishTrimmed=false the assembly store's type
         registration fails on this toolchain (JNI n_onCreate missing), and the
         kernel's reflection-based JSON must be rooted explicitly. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep the kernel assemblies intact: JSON DTOs are used reflectively. -->
    <TrimmerRootAssembly Include="Mosaic.Mobile.App" RootMode="All" />
    <TrimmerRootAssembly Include="Mosaic.Mobile.Core" RootMode="All" />
    <TrimmerRootAssembly Include="Mosaic.Mobile.Wire" RootMode="All" />
  </ItemGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Text.Json.JsonSerializer.IsReflectionEnabledByDefault" Value="true" Trim="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mosaic.Mobile.Core\Mosaic.Mobile.Core.csproj" />
    <ProjectReference Include="..\Mosaic.Mobile.Wire\Mosaic.Mobile.Wire.csproj" />
  </ItemGroup>
</Project>
