<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:presentation="clr-namespace:Mosaic.Mobile.Presentation;assembly=Mosaic.Mobile.Presentation"
             x:Class="Mosaic.Mobile.App.Pages.SettingsPage"
             x:DataType="presentation:SettingsViewModel"
             Title="{Binding TitleText}">

  <ScrollView>
    <VerticalStackLayout Padding="16" Spacing="14">

      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="4">
          <Label Text="{Binding ServerLabel}" Style="{StaticResource SectionLabel}" />
          <Label Text="{Binding ServerText}" Style="{StaticResource MutedLabel}" />
          <Label Text="{Binding AccountLabel}" Style="{StaticResource SectionLabel}" Margin="0,8,0,0" />
          <Label Text="{Binding AccountText}" Style="{StaticResource MutedLabel}" />
        </VerticalStackLayout>
      </Border>

      <VerticalStackLayout Spacing="6">
        <Label Text="{Binding ThemeTitle}" Style="{StaticResource SectionLabel}" />
        <HorizontalStackLayout Spacing="8">
          <Button Text="{Binding ThemeFollowText}" Style="{StaticResource SecondaryButton}"
                  Command="{Binding SetThemeCommand}" CommandParameter="FollowSystem" />
          <Button Text="{Binding ThemeLightText}" Style="{StaticResource SecondaryButton}"
                  Command="{Binding SetThemeCommand}" CommandParameter="Light" />
          <Button Text="{Binding ThemeDarkText}" Style="{StaticResource SecondaryButton}"
                  Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
        </HorizontalStackLayout>
        <Label Text="{Binding HighContrastText}"
               IsVisible="{Binding HighContrastNoticeVisible}"
               Style="{StaticResource MutedLabel}" />
      </VerticalStackLayout>

      <VerticalStackLayout Spacing="6">
        <Label Text="{Binding LanguageTitle}" Style="{StaticResource SectionLabel}" />
        <HorizontalStackLayout Spacing="8">
          <Button Text="{Binding LanguageFollowText}" Style="{StaticResource SecondaryButton}"
                  Command="{Binding SetLanguageCommand}" CommandParameter="FollowSystem" />
          <Button Text="{Binding LanguageChineseText}" Style="{StaticResource SecondaryButton}"
                  Command="{Binding SetLanguageCommand}" CommandParameter="Chinese" />
          <Button Text="{Binding LanguageEnglishText}" Style="{StaticResource SecondaryButton}"
                  Command="{Binding SetLanguageCommand}" CommandParameter="English" />
        </HorizontalStackLayout>
        <Label Text="{Binding LocalHintText}" Style="{StaticResource MutedLabel}" />
      </VerticalStackLayout>

      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="8">
          <Label Text="{Binding LastSyncedText}" Style="{StaticResource MutedLabel}" />
          <Label Text="{Binding CachedTasksText}" Style="{StaticResource MutedLabel}" />
          <Button Text="{Binding SyncNowText}" Command="{Binding SyncNowCommand}" />
          <Button Text="{Binding RebuildText}" Style="{StaticResource SecondaryButton}"
                  Command="{Binding BeginRebuildCommand}" />
          <Border Style="{StaticResource Card}" IsVisible="{Binding RebuildConfirmVisible}">
            <VerticalStackLayout Spacing="8">
              <Label Text="{Binding RebuildConfirmText}" />
              <HorizontalStackLayout Spacing="8">
                <Button Text="{Binding ConfirmText}" Command="{Binding ConfirmRebuildCommand}" />
                <Button Text="{Binding CancelText}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelRebuildCommand}" />
              </HorizontalStackLayout>
            </VerticalStackLayout>
          </Border>
        </VerticalStackLayout>
      </Border>

      <VerticalStackLayout Spacing="4">
        <Label Text="{Binding AboutTitle}" Style="{StaticResource SectionLabel}" />
        <Label Text="{Binding AppDescriptionText}" Style="{StaticResource MutedLabel}" />
        <Label Text="{Binding VersionLabel}" Style="{StaticResource MutedLabel}" />
        <Label Text="{Binding VersionText}" Style="{StaticResource MutedLabel}" />
      </VerticalStackLayout>

      <Label Text="{Binding ErrorText}"
             IsVisible="{Binding ErrorText, Converter={StaticResource NotEmpty}}"
             Style="{StaticResource ErrorLabel}" />
      <Label Text="{Binding NoticeText}"
             IsVisible="{Binding NoticeText, Converter={StaticResource NotEmpty}}"
             Style="{StaticResource MutedLabel}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
