<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:presentation="clr-namespace:Mosaic.Mobile.Presentation;assembly=Mosaic.Mobile.Presentation"
             x:Class="Mosaic.Mobile.App.Pages.SignInPage"
             x:DataType="presentation:SignInViewModel"
             Title="{Binding SignInTitleText}">

  <ScrollView>
    <VerticalStackLayout Padding="16" Spacing="12">

      <Label Text="{Binding SignInTitleText}" Style="{StaticResource TitleLabel}" />
      <Label Text="{Binding SignInHintText}" Style="{StaticResource MutedLabel}" />

      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="6">
          <Label Text="{Binding ServerUrlLabel}" Style="{StaticResource SectionLabel}" />
          <Entry Text="{Binding ServerUrl}" Keyboard="Url"
                 IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                 AutomationProperties.Name="{Binding ServerUrlLabel}" />
          <Button Text="{Binding ConnectText}" Style="{StaticResource SecondaryButton}"
                  Command="{Binding ConnectServerCommand}" />
          <Label Text="{Binding ServerNameText}" Style="{StaticResource MutedLabel}" />
        </VerticalStackLayout>
      </Border>

      <Entry Placeholder="{Binding EmailLabel}" Text="{Binding Email}" Keyboard="Email"
             AutomationProperties.Name="{Binding EmailLabel}" />

      <VerticalStackLayout Spacing="6" IsVisible="{Binding IsPasswordMode}">
        <Entry Placeholder="{Binding PasswordLabel}" Text="{Binding Password}" IsPassword="True"
               AutomationProperties.Name="{Binding PasswordLabel}" />
      </VerticalStackLayout>

      <VerticalStackLayout Spacing="6" IsVisible="{Binding UseCodeLogin}">
        <Entry Placeholder="{Binding CodeLabel}" Text="{Binding Code}" Keyboard="Numeric"
               AutomationProperties.Name="{Binding CodeLabel}" />
        <Button Text="{Binding SendCodeText}" Style="{StaticResource SecondaryButton}"
                Command="{Binding SendLoginCodeCommand}" />
      </VerticalStackLayout>

      <Button Text="{Binding SignInText}" Command="{Binding SignInCommand}" />

      <Button Text="{Binding CodeModeText}" Style="{StaticResource SecondaryButton}"
              IsVisible="{Binding IsPasswordMode}" Command="{Binding UseCodeModeCommand}" />
      <Button Text="{Binding PasswordModeText}" Style="{StaticResource SecondaryButton}"
              IsVisible="{Binding UseCodeLogin}" Command="{Binding UsePasswordModeCommand}" />

      <Button Text="{Binding ForgotText}" Style="{StaticResource SecondaryButton}"
              Command="{Binding OpenForgotCommand}" />

      <Label Text="{Binding ErrorText}"
             IsVisible="{Binding ErrorText, Converter={StaticResource NotEmpty}}"
             Style="{StaticResource ErrorLabel}" />
      <Label Text="{Binding NoticeText}"
             IsVisible="{Binding NoticeText, Converter={StaticResource NotEmpty}}"
             Style="{StaticResource MutedLabel}" />

      <Button Text="{Binding RegisterText}" Style="{StaticResource SecondaryButton}"
              Command="{Binding OpenRegisterCommand}" />
      <Button Text="{Binding DeviceFlowText}" Style="{StaticResource SecondaryButton}"
              Command="{Binding OpenDeviceFlowCommand}" />
      <Button Text="{Binding OfflineText}" Style="{StaticResource SecondaryButton}"
              Command="{Binding GoOfflineCommand}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
