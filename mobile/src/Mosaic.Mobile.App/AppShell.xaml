<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="Mosaic.Mobile.App.AppShell"
       FlyoutBehavior="Disabled">

  <TabBar>
    <Tab Title="{Binding TasksTitle}">
      <ShellContent x:Name="TasksTab" Route="tasks" />
    </Tab>
    <Tab Title="{Binding AccountTitle}">
      <ShellContent x:Name="AccountTab" Route="account" />
    </Tab>
    <Tab Title="{Binding SettingsTitle}">
      <ShellContent x:Name="SettingsTab" Route="settings" />
    </Tab>
  </TabBar>
</Shell>
