<?xml version="1.0" encoding="utf-8"?>
<!--
  4 columns x 1-2 rows. 250dp is the 4-cell minimum per the platform formula
  (4 cells x 70dp - 30dp). targetCellWidth/Height are the API 31+ hints that
  make a fresh placement land on 4x1; the launcher may still clamp the span to
  the screen width, which is a device limit, not a config error.
  The 140dp maximum is exactly two usable rows plus the 16dp card padding;
  a taller card would gain whitespace, not another task.
  resizeMode is vertical only: the widget never gets narrower or wider.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:minResizeWidth="250dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="250dp"
    android:maxResizeHeight="140dp"
    android:updatePeriodMillis="0"
    android:resizeMode="vertical"
    android:configure="app.mosaic.tasks.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_tasks"
    android:previewLayout="@layout/widget_tasks_preview"
    android:description="@string/widget_description" />
