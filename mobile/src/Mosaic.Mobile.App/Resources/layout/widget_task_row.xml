<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
  <LinearLayout android:id="@+id/widget_row_root" android:layout_width="match_parent" android:layout_height="44dp"
      android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="12dp">
    <ImageView android:id="@+id/widget_row_circle" android:layout_width="44dp" android:layout_height="match_parent"
        android:scaleType="centerInside" android:paddingStart="10dp" android:paddingEnd="10dp" />
    <TextView android:id="@+id/widget_row_title" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:ellipsize="end" android:fontFamily="sans-serif-medium"
        android:maxLines="1" android:textColor="@color/widget_on_surface" android:textSize="14sp" />
  </LinearLayout>
</FrameLayout>
