<?xml version="1.0" encoding="utf-8"?>
<!--
  M2.5 widget surface. RemoteViews whitelist only: FrameLayout, LinearLayout,
  TextView, ImageView, ListView. A ListView backed by a RemoteViewsService is
  the only supported way to get native vertical scrolling in an app widget.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/widget_outline"
        android:dividerHeight="1dp"
        android:scrollbars="none"
        android:fastScrollEnabled="false"
        android:cacheColorHint="@android:color/transparent"
        android:listSelector="@android:color/transparent" />
</FrameLayout>
