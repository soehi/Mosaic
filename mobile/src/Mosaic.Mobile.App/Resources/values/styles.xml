<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- A small dialog used only by the widget's reconfigure entry point. It is
       not an app screen: no ActionBar, no navigation, no launcher icon. -->
  <style name="WidgetConfigTheme" parent="@android:style/Theme.Material.Dialog.Alert">
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowIsFloating">true</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:windowBackground">@color/widget_surface</item>
    <item name="android:textColorPrimary">@color/widget_on_surface</item>
    <item name="android:colorAccent">@color/widget_primary</item>
  </style>
</resources>
