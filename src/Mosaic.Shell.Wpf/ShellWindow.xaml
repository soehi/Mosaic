<Window x:Class="Mosaic.Shell.Wpf.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mosaic.Shell.Wpf"
        xmlns:theme="clr-namespace:Mosaic.Presentation.Wpf;assembly=Mosaic.Presentation.Wpf"
        Title="Mosaic"
        Width="1220"
        Height="780"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static theme:MosaicTheme.CanvasBrushKey}}"
        Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextPrimaryBrushKey}}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <local:NavigationIconConverter x:Key="NavigationIcon"/>
        <local:NavigationItemEqualsConverter x:Key="NavigationItemEquals"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource {x:Static theme:MosaicTheme.SidebarBrushKey}}"
                BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="20,28,16,22">
                <StackPanel DockPanel.Dock="Top" Margin="2,0,0,42">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30"
                                Height="30"
                                Margin="0,0,9,0"
                                Background="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"
                                CornerRadius="8">
                            <TextBlock Text="▦"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.AccentBrushKey}}"/>
                        </Border>
                        <TextBlock Text="Mosaic"
                                   VerticalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextPrimaryBrushKey}}"/>
                    </StackPanel>
                    <TextBlock Text="让每一件事，有迹可循"
                               Margin="1,10,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceMutedBrushKey}}"
                            BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="12,10">
                        <DockPanel>
                            <Ellipse Width="7"
                                     Height="7"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource {x:Static theme:MosaicTheme.FocusBrushKey}}"/>
                            <TextBlock Text="本机工作空间"
                                       FontSize="12"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                        </DockPanel>
                    </Border>
                    <TextBlock Text="离线可用 · 数据保存在此电脑"
                               Margin="4,10,0,0"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                </StackPanel>

                <ItemsControl x:Name="NavigationItems" ItemsSource="{Binding Navigation}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    HorizontalContentAlignment="Left"
                                    Margin="0,0,0,6"
                                    Padding="14,10">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource {x:Static theme:MosaicTheme.QuietButtonKey}}">
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource NavigationItemEquals}">
                                                        <Binding Path="Id"/>
                                                        <Binding Path="DataContext.CurrentNavigationId"
                                                                 RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Background"
                                                        Value="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IconKey, Converter={StaticResource NavigationIcon}}"
                                               Width="22"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               TextAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="66"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                    BorderThickness="0,0,0,1"
                    Padding="32,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Text="MOSAIC / 工作空间"
                               DockPanel.Dock="Right"
                               FontSize="10"
                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                    <TextBlock Text="{Binding PageTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextPrimaryBrushKey}}"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Border x:Name="EmptyWorkspace"
                        MaxWidth="540"
                        Margin="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="38,34"
                        Visibility="{Binding Content, ElementName=PageContent, Converter={StaticResource NullToVisibility}}">
                    <StackPanel>
                        <Border Width="46"
                                Height="46"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"
                                CornerRadius="12">
                            <TextBlock Text="✓"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.AccentBrushKey}}"/>
                        </Border>
                        <TextBlock Text="工作空间已就绪"
                                   Margin="0,20,0,0"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="当前没有启用的功能。修改模块配置并重启后即可使用。"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                    </StackPanel>
                </Border>
                <ContentControl x:Name="PageContent"
                                Content="{Binding Content}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="{DynamicResource {x:Static theme:MosaicTheme.CanvasBrushKey}}">
                    <ContentControl.Template>
                        <ControlTemplate TargetType="ContentControl">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter ContentSource="Content"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </ContentControl.Template>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <Trigger Property="Content" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
