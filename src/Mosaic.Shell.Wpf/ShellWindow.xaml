<Window x:Class="Mosaic.Shell.Wpf.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mosaic.Shell.Wpf"
        xmlns:theme="clr-namespace:Mosaic.Presentation.Wpf;assembly=Mosaic.Presentation.Wpf"
        Title="Mosaic"
        Width="1504"
        Height="1012"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static theme:MosaicTheme.CanvasBrushKey}}"
        Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextPrimaryBrushKey}}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="OnLoaded"
        SizeChanged="OnSizeChanged">
    <Window.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <local:NavigationIconConverter x:Key="NavigationIcon"/>
        <local:NavigationItemEqualsConverter x:Key="NavigationItemEquals"/>
        <local:StatusActionAvailableConverter x:Key="StatusActionAvailable"/>
        <local:StatusActionHiddenConverter x:Key="StatusActionHidden"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="Sidebar"
                ClipToBounds="True"
                Background="{DynamicResource {x:Static theme:MosaicTheme.SidebarBrushKey}}"
                BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                BorderThickness="0,0,1,0">
            <DockPanel x:Name="SidebarContent" Margin="20,28,16,22">
                <StackPanel x:Name="BrandPanel" DockPanel.Dock="Top" Margin="2,0,0,42">
                    <DockPanel x:Name="BrandLockup">
                        <Border x:Name="BrandMark"
                                DockPanel.Dock="Left"
                                Width="30"
                                Height="30"
                                Margin="0,0,9,0"
                                Background="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"
                                CornerRadius="8">
                            <TextBlock Text="▦"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.AccentBrushKey}}"/>
                        </Border>
                        <TextBlock x:Name="BrandText"
                                   Text="Mosaic"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextPrimaryBrushKey}}"/>
                    </DockPanel>
                    <TextBlock x:Name="BrandTagline"
                               Text="{DynamicResource Shell.Tagline}"
                               Margin="1,10,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                </StackPanel>

                <StackPanel x:Name="StatusPanel" DockPanel.Dock="Bottom">
                    <ItemsControl x:Name="SidebarStatusItems" ItemsSource="{Binding SidebarStatusItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceMutedBrushKey}}"
                                        BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="12,10"
                                        Margin="0,0,0,10"
                                        ToolTip="{Binding ToolTip}"
                                        AutomationProperties.AutomationId="SidebarStatusItem"
                                        AutomationProperties.Name="{Binding Text}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Command="{Binding DataContext.StatusActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding ActionToolTip}"
                                                AutomationProperties.AutomationId="SidebarStatusAction"
                                                AutomationProperties.Name="{Binding ActionToolTip}"
                                                Style="{StaticResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                                MinHeight="28"
                                                MinWidth="28"
                                                Padding="6,2"
                                                VerticalAlignment="Center">
                                            <Button.Visibility>
                                                <MultiBinding Converter="{StaticResource StatusActionAvailable}">
                                                    <Binding Path="CanAct"/>
                                                    <Binding Path="ActionLabel"/>
                                                    <Binding Path="ActionGlyph"/>
                                                </MultiBinding>
                                            </Button.Visibility>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ActionGlyph}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                                                <TextBlock Text="{Binding ActionLabel}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Margin" Value="6,0,0,0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ActionLabel}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ActionLabel}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSidebarCompact, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.NavigateToViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding TargetViewId}"
                                                ToolTip="{Binding ToolTip}"
                                                AutomationProperties.Name="{Binding ToolTip}"
                                                Style="{StaticResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                MinHeight="28"
                                                Padding="0,2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Glyph}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                                                <TextBlock x:Name="SidebarStatusText"
                                                           Text="{Binding Text}"
                                                           Margin="8,0,0,0"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                                                <TextBlock x:Name="SidebarStatusDetail"
                                                           Text="{Binding Detail}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Margin" Value="7,0,0,0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Detail}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSidebarCompact, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="WorkspaceStatusCard"
                            Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceMutedBrushKey}}"
                            BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="12,10"
                            ToolTip="{DynamicResource Shell.WorkspaceStatusDetail}"
                            AutomationProperties.Name="{DynamicResource Shell.WorkspaceStatusAccessibility}">
                        <DockPanel>
                            <Ellipse x:Name="WorkspaceStatusDot"
                                     Width="7"
                                     Height="7"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     ToolTip="{DynamicResource Shell.WorkspaceStatusDetail}"
                                     AutomationProperties.Name="{DynamicResource Shell.WorkspaceStatusAccessibility}"
                                     Fill="{DynamicResource {x:Static theme:MosaicTheme.FocusBrushKey}}"/>
                            <TextBlock x:Name="StatusText"
                                       Text="{DynamicResource Shell.WorkspaceStatus}"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="12"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="StatusDetail"
                               Text="{DynamicResource Shell.WorkspaceStatusDetail}"
                               Margin="4,10,0,0"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                    <TextBlock x:Name="VersionText"
                               Text="v0.0.0"
                               Margin="4,6,0,0"
                               FontSize="10"
                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"
                               AutomationProperties.AutomationId="AppVersion"/>
                </StackPanel>

                <ItemsControl x:Name="NavigationItems" ItemsSource="{Binding Navigation}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Label}"
                                    AutomationProperties.Name="{Binding Label}">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource {x:Static theme:MosaicTheme.QuietButtonKey}}">
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        <Setter Property="MinHeight" Value="44"/>
                                        <Setter Property="Padding" Value="13,0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarCompact, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="True">
                                                <Setter Property="Width" Value="44"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </DataTrigger>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource NavigationItemEquals}">
                                                        <Binding Path="Id"/>
                                                        <Binding Path="DataContext.CurrentNavigationId"
                                                                 RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Background"
                                                        Value="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="NavigationGlyph" Width="22"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               TextAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource NavigationIcon}">
                                                <Binding Path="IconKey"/>
                                                <Binding Path="Label"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock x:Name="NavigationLabel"
                                               Text="{Binding Label}"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarCompact, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="True">
                                    <Setter TargetName="NavigationLabel"
                                            Property="Visibility"
                                            Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Thumb x:Name="SidebarResizeHandle" Width="6" HorizontalAlignment="Right"
               Panel.ZIndex="3" Cursor="SizeWE" Focusable="True"
               DragStarted="OnSidebarResizeStarted" DragDelta="OnSidebarResizeDelta" DragCompleted="OnSidebarResizeCompleted"
               PreviewKeyDown="OnSidebarResizeKeyDown" MouseDoubleClick="OnSidebarResizeReset"
               ToolTip="{DynamicResource Shell.ResizeSidebar}"
               AutomationProperties.Name="{DynamicResource Shell.ResizeSidebar}"
               AutomationProperties.AutomationId="SidebarResizeHandle">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Border x:Name="ResizeLine" Width="2" HorizontalAlignment="Right" Background="Transparent"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ResizeLine" Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.FocusBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ResizeLine" Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.FocusBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ResizeLine" Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.FocusBrushKey}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="66"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="TopBar"
                    BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                    BorderThickness="0,0,0,1"
                    Padding="32,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock x:Name="WorkspaceBreadcrumb"
                               Text="{DynamicResource Shell.WorkspaceBreadcrumb}"
                               DockPanel.Dock="Right"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCompact, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="True">
                                        <Setter Property="Text" Value="MOSAIC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding PageTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextPrimaryBrushKey}}"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Border x:Name="EmptyWorkspace"
                        MaxWidth="540"
                        Margin="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="38,34"
                        Visibility="{Binding Content, ElementName=PageContent, Converter={StaticResource NullToVisibility}}">
                    <StackPanel>
                        <Border Width="46"
                                Height="46"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"
                                CornerRadius="12">
                            <TextBlock Text="✓"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.AccentBrushKey}}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Shell.EmptyTitle}"
                                   Margin="0,20,0,0"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Shell.EmptyDescription}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                    </StackPanel>
                </Border>

                <ContentControl x:Name="PageContent"
                                Content="{Binding Content}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="{DynamicResource {x:Static theme:MosaicTheme.CanvasBrushKey}}">
                    <ContentControl.Template>
                        <ControlTemplate TargetType="ContentControl">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter ContentSource="Content"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </ContentControl.Template>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <Trigger Property="Content" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>

            <Border x:Name="StatusBar"
                    Grid.Row="2"
                    Height="36"
                    Padding="32,0"
                    Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceMutedBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                    BorderThickness="0,1,0,0"
                    AutomationProperties.AutomationId="StatusBar">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusItems.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ItemsControl x:Name="StatusItemsControl"
                              ItemsSource="{Binding StatusItems}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              AutomationProperties.AutomationId="StatusItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.NavigateToViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding TargetViewId}"
                                    ToolTip="{Binding ToolTip}"
                                    AutomationProperties.Name="{Binding ToolTip}"
                                    Style="{StaticResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                    MinHeight="28"
                                    Padding="10,3"
                                    Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                                    <TextBlock Text="{Binding Text}"
                                               Margin="7,0,0,0"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                                    <TextBlock Text="{Binding Detail}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Margin" Value="7,0,0,0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Detail}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="›"
                                               Margin="8,0,0,0"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Grid>
</Window>
