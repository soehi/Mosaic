<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Mosaic.Presentation.Wpf">
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.CanvasBrushKey}" Color="#0B110D"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.SurfaceBrushKey}" Color="#18211B"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.SurfaceMutedBrushKey}" Color="#212C24"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.SidebarBrushKey}" Color="#0F1612"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.BorderBrushKey}" Color="#3A4C41"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.TextPrimaryBrushKey}" Color="#E6F0E9"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.TextSecondaryBrushKey}" Color="#C0D0C4"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.TextMutedBrushKey}" Color="#A0B3A5"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.AccentBrushKey}" Color="#9CD7AF"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.AccentTextBrushKey}" Color="#C7F0D5"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.AccentButtonBackgroundBrushKey}" Color="#5FA984"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.AccentButtonTextBrushKey}" Color="#07130D"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.AccentHoverBrushKey}" Color="#78BA95"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.AccentSoftBrushKey}" Color="#223E30"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.DangerBrushKey}" Color="#F1A094"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.DangerSoftBrushKey}" Color="#39221E"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.DangerBorderBrushKey}" Color="#7F4A42"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.FocusBrushKey}" Color="#82C39D"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.ControlHoverBorderBrushKey}" Color="#62806D"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.SelectionBrushKey}" Color="#3F7057"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.ScrollThumbBrushKey}" Color="#50665A"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.ScrollThumbHoverBrushKey}" Color="#718B7B"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.DisabledSurfaceBrushKey}" Color="#2A352E"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.DisabledTextBrushKey}" Color="#91A096"/>
</ResourceDictionary>
