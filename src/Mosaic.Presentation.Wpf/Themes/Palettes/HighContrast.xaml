<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Mosaic.Presentation.Wpf">
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.CanvasBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.SurfaceBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.SurfaceMutedBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.SidebarBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.BorderBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.TextPrimaryBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.TextSecondaryBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.TextMutedBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.AccentBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.AccentTextBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.AccentButtonBackgroundBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.AccentButtonTextBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.AccentHoverBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.AccentSoftBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.DangerBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.DangerSoftBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.DangerBorderBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.FocusBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.ControlHoverBorderBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.SelectionBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.ScrollThumbBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.ScrollThumbHoverBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.DisabledSurfaceBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static theme:MosaicTheme.DisabledTextBrushKey}"
                     Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}"/>
</ResourceDictionary>
