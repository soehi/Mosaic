<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="clr-namespace:Mosaic.Presentation.Wpf;assembly=Mosaic.Presentation.Wpf">
    <Geometry x:Key="FloatingRestoreIcon">M 13.5,8.5 V 12.5 Q 13.5,13.5 12.5,13.5 H 3.5 Q 2.5,13.5 2.5,12.5 V 3.5 Q 2.5,2.5 3.5,2.5 H 7.5 M 8.5,7.5 L 13.5,2.5 M 10,2.5 H 13.5 V 6</Geometry>
    <Geometry x:Key="FloatingPinIcon">M 8.7,2 L 14,7.3 12.7,8.6 11.5,8.2 9.5,10.2 9.4,12.2 8.7,12.9 3.1,7.3 3.8,6.6 5.8,6.5 7.8,4.5 7.4,3.3 Z M 5.9,10.1 L 2.5,13.5</Geometry>
    <GeometryGroup x:Key="FloatingPinnedIcon">
        <StaticResource ResourceKey="FloatingPinIcon"/>
    </GeometryGroup>
    <Geometry x:Key="FloatingCloseIcon">M 3.5,3.5 L 12.5,12.5 M 12.5,3.5 L 3.5,12.5</Geometry>

    <DataTemplate x:Key="FloatingToolIconTemplate">
        <Path x:Name="Icon" Data="{Binding}" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="{StaticResource FloatingPinnedIcon}">
                <Setter TargetName="Icon" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="FloatingToolButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.TextPrimaryBrushKey}}"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource MosaicButtonFocusVisual}"/>
        <Setter Property="ContentTemplate" Value="{StaticResource FloatingToolIconTemplate}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.SurfaceMutedBrushKey}}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.AccentHoverBrushKey}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.AccentButtonTextBrushKey}}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.DisabledTextBrushKey}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="FloatingCloseToolButtonStyle" TargetType="Button" BasedOn="{StaticResource FloatingToolButtonStyle}">
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsEnabled" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.DangerSoftBrushKey}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"/>
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
