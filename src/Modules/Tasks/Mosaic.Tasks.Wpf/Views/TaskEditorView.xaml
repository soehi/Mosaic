<UserControl x:Class="Mosaic.Tasks.Wpf.Views.TaskEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Mosaic.Presentation.Wpf;assembly=Mosaic.Presentation.Wpf"
             ClipToBounds="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}"
            BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="CompactNavigationBar"
                    Grid.Row="0"
                    Padding="10,8"
                    Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                <Button x:Name="BackToTaskListButton"
                        Content="‹  返回任务列表"
                        Command="{Binding BackToListCommand}"
                        HorizontalAlignment="Left"
                        Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                        AutomationProperties.AutomationId="BackToTaskList"
                        AutomationProperties.Name="返回任务列表"/>
            </Border>

            <ScrollViewer x:Name="FormScrollViewer"
                          Grid.Row="1"
                          Padding="22,20,14,12"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ClipToBounds="True"
                          UseLayoutRounding="True"
                          SnapsToDevicePixels="True">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right"
                                Margin="12,0,0,0"
                                Padding="8,4"
                                Background="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"
                                CornerRadius="10"
                                Visibility="{Binding Editor.IsDirty, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="尚未保存"
                                       FontSize="10"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"/>
                        </Border>
                        <TextBlock Text="{Binding Editor.Heading}"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Editor.Metadata}"
                               Margin="0,7,0,18"
                               FontSize="11"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>

                    <Border Margin="0,0,0,16"
                            Padding="12,11"
                            Background="{DynamicResource {x:Static theme:MosaicTheme.DangerSoftBrushKey}}"
                            BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Visibility="{Binding HasConflict, Converter={StaticResource BoolVisibility}}"
                            AutomationProperties.AutomationId="TaskConflict">
                        <StackPanel>
                            <TextBlock Text="这项任务已在别处更新"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"/>
                            <TextBlock Text="{Binding Error}"
                                       Margin="0,5,0,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextPrimaryBrushKey}}"/>
                            <TextBlock Text="当前输入会保留。重新加载最新版本后再修改。"
                                       Margin="0,4,0,9"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                            <Button Content="重新加载最新版本"
                                    Command="{Binding ReloadCommand}"
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                    AutomationProperties.AutomationId="ReloadConflictTask"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="任务标题"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Editor.TitleHelpText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                    </Grid>
                    <TextBox Text="{Binding Editor.Title, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEdit}"
                             TextWrapping="Wrap"
                             AutomationProperties.AutomationId="TaskTitle"/>
                    <Grid Margin="0,5,0,0">
                        <TextBlock Text="{Binding Editor.TitleError}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"
                                   Visibility="{Binding Editor.HasTitleError, Converter={StaticResource BoolVisibility}}"/>
                        <TextBlock Text="{Binding Editor.TitleCountLabel}"
                                   HorizontalAlignment="Right"
                                   FontSize="10"
                                   Visibility="{Binding ShowCharacterCount, Converter={StaticResource BoolVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Editor.TitleExceedsLimit}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="0,16,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="备注"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Editor.NotesHelpText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                    </Grid>
                    <TextBox x:Name="NotesTextBox"
                             Text="{Binding Editor.Notes, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEdit}"
                             MinHeight="{Binding NotesMinHeight}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.AutomationId="TaskNotes"/>
                    <Grid Margin="0,5,0,2">
                        <TextBlock Text="{Binding Editor.NotesError}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"
                                   Visibility="{Binding Editor.HasNotesError, Converter={StaticResource BoolVisibility}}"/>
                        <TextBlock Text="{Binding Editor.NotesCountLabel}"
                                   HorizontalAlignment="Right"
                                   FontSize="10"
                                   Visibility="{Binding ShowCharacterCount, Converter={StaticResource BoolVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Editor.NotesExceedsLimit}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Margin="0,10,0,0"
                            Padding="11,9"
                            Background="{DynamicResource {x:Static theme:MosaicTheme.DangerSoftBrushKey}}"
                            BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasGeneralError, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding Error}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"
                                   AutomationProperties.AutomationId="TaskError"/>
                    </Border>
                    <Border Margin="0,10,0,0"
                            Padding="11,9"
                            Background="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"
                            CornerRadius="8"
                            Visibility="{Binding HasMessage, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding Message}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"
                                   AutomationProperties.AutomationId="TaskMessage"/>
                    </Border>

                    <TextBlock Text="{Binding Editor.StateLabel}"
                               Margin="0,14,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"
                               Visibility="{Binding Editor.HasTask, Converter={StaticResource BoolVisibility}}"/>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="EditorActionBar"
                    Grid.Row="2"
                    Padding="14,12"
                    Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceMutedBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                    BorderThickness="0,1,0,0">
                <StackPanel>
                    <Border Margin="0,0,0,8"
                            Padding="9,6"
                            Background="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"
                            CornerRadius="7"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                            AutomationProperties.AutomationId="TaskBusy">
                        <TextBlock Text="{Binding BusyFeedback}"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"/>
                    </Border>

                    <Button Content="保存任务"
                            Command="{Binding SaveCommand}"
                            MinWidth="{Binding TaskButtonMinWidth}"
                            MinHeight="{Binding TaskButtonMinHeight}"
                            Style="{DynamicResource {x:Static theme:MosaicTheme.AccentButtonKey}}"
                            ToolTip="填写或修改内容后即可保存"
                            AutomationProperties.AutomationId="SaveTask"/>
                    <TextBlock Text="填写或修改内容后即可保存"
                               Margin="0,5,0,0"
                               HorizontalAlignment="Center"
                               FontSize="10"
                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>

                    <Grid x:Name="EditorActionGrid"
                          Margin="0,9,0,0"
                          Visibility="{Binding Editor.HasTask, Converter={StaticResource BoolVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="7"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="7"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="EditorActionSecondRow" Height="0"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="ToggleButton"
                                Content="{Binding Editor.ToggleLabel}"
                                Command="{Binding ToggleCommand}"
                                MinWidth="{Binding TaskButtonMinWidth}"
                                MinHeight="{Binding TaskButtonMinHeight}"
                                Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                AutomationProperties.AutomationId="ToggleTask"/>
                        <Button x:Name="ReloadButton"
                                MinWidth="{Binding TaskButtonMinWidth}"
                                Grid.Column="2"
                                Content="重新加载"
                                Command="{Binding ReloadCommand}"
                                MinHeight="{Binding TaskButtonMinHeight}"
                                Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                AutomationProperties.AutomationId="ReloadTask"/>
                        <Button x:Name="DeleteButton"
                                Grid.Column="4"
                                Content="删除"
                                Command="{Binding DeleteCommand}"
                                MinWidth="{Binding TaskButtonMinWidth}"
                                MinHeight="{Binding TaskButtonMinHeight}"
                                Style="{DynamicResource {x:Static theme:MosaicTheme.DangerButtonKey}}"
                                AutomationProperties.AutomationId="DeleteTask"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
