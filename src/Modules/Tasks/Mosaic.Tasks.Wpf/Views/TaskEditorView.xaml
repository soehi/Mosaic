<UserControl x:Class="Mosaic.Tasks.Wpf.Views.TaskEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Mosaic.Presentation.Wpf;assembly=Mosaic.Presentation.Wpf"
             Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextPrimaryBrushKey}}"
             FontSize="14"
             ClipToBounds="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}"
            BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="CompactNavigationBar"
                    Grid.Row="0"
                    Padding="10,8"
                    Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                <Button x:Name="BackToTaskListButton"
                        Content="{DynamicResource Tasks.BackToList}"
                        Command="{Binding BackToListCommand}"
                        HorizontalAlignment="Left"
                        Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                        AutomationProperties.AutomationId="BackToTaskList"
                        AutomationProperties.Name="{DynamicResource Tasks.BackToList}"/>
            </Border>

            <ScrollViewer x:Name="FormScrollViewer"
                          Grid.Row="1"
                          Padding="22,20,14,12"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ClipToBounds="True"
                          UseLayoutRounding="True"
                          SnapsToDevicePixels="True">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right"
                                Margin="12,0,0,0"
                                Padding="8,4"
                                Background="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"
                                CornerRadius="10"
                                Visibility="{Binding Editor.IsDirty, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{DynamicResource Tasks.NotSaved}"
                                       FontSize="12"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"/>
                        </Border>
                        <TextBlock Text="{Binding Editor.Heading}"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Editor.Metadata}"
                               Margin="0,7,0,18"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>

                    <Border Margin="0,0,0,16"
                            Padding="12,11"
                            Background="{DynamicResource {x:Static theme:MosaicTheme.DangerSoftBrushKey}}"
                            BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Visibility="{Binding HasConflict, Converter={StaticResource BoolVisibility}}"
                            AutomationProperties.AutomationId="TaskConflict">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Tasks.ConflictTitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"/>
                            <TextBlock Text="{Binding Error}"
                                       Margin="0,5,0,0"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextPrimaryBrushKey}}"/>
                            <TextBlock Text="{DynamicResource Tasks.ConflictDescription}"
                                       Margin="0,4,0,9"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                            <Button Content="{DynamicResource Tasks.ReloadLatest}"
                                    Command="{Binding ReloadCommand}"
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                    AutomationProperties.AutomationId="ReloadConflictTask"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Tasks.TitleLabel}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Editor.TitleHelpText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                    </Grid>
                    <TextBox Text="{Binding Editor.Title, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsArchived}" IsEnabled="{Binding CanEdit}"
                             TextWrapping="Wrap"
                             AutomationProperties.AutomationId="TaskTitle"/>
                    <Grid Margin="0,5,0,0">
                        <TextBlock Text="{Binding Editor.TitleError}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"
                                   Visibility="{Binding Editor.HasTitleError, Converter={StaticResource BoolVisibility}}"/>
                        <TextBlock Text="{Binding Editor.TitleCountLabel}"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   Visibility="{Binding ShowCharacterCount, Converter={StaticResource BoolVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Editor.TitleExceedsLimit}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="0,16,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Tasks.NotesLabel}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Editor.NotesHelpText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                    </Grid>
                    <TextBox x:Name="NotesTextBox"
                             Text="{Binding Editor.Notes, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsArchived}" IsEnabled="{Binding CanEdit}"
                             MinHeight="{Binding NotesMinHeight}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.AutomationId="TaskNotes"/>
                    <Grid Margin="0,5,0,2">
                        <TextBlock Text="{Binding Editor.NotesError}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"
                                   Visibility="{Binding Editor.HasNotesError, Converter={StaticResource BoolVisibility}}"/>
                        <TextBlock Text="{Binding Editor.NotesCountLabel}"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   Visibility="{Binding ShowCharacterCount, Converter={StaticResource BoolVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Editor.NotesExceedsLimit}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- 附件区块 -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding Editor.HasTask, Converter={StaticResource BoolVisibility}}">
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Tasks.Attachments.Label}"
                                       FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Editor.AttachmentLimitLabel}"
                                       FontSize="12"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                        </Grid>

                        <!-- 拖放区域 -->
                        <Border x:Name="AttachmentDropZone"
                                AllowDrop="{Binding Editor.CanManageAttachments}"
                                Padding="10,8"
                                Margin="0,0,0,6"
                                BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceMutedBrushKey}}"
                                DragOver="AttachmentDropZone_DragOver"
                                Drop="AttachmentDropZone_Drop"
                                DragLeave="AttachmentDropZone_DragLeave"
                                Cursor="Hand"
                                MouseLeftButtonUp="AttachmentDropZone_Click">
                            <TextBlock Text="{DynamicResource Tasks.Attachments.DropHint}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                        </Border>

                        <!-- 附件列表 -->
                        <ItemsControl ItemsSource="{Binding Editor.Attachments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="AttachmentItem"
                                            Padding="8,5"
                                            Margin="0,0,0,4"
                                            CornerRadius="6"
                                            Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}"
                                            BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                                            BorderThickness="1"
                                            PreviewMouseLeftButtonDown="AttachmentItem_MouseDown"
                                            PreviewMouseMove="AttachmentItem_MouseMove"
                                            Cursor="SizeAll"
                                            ToolTip="{DynamicResource Tasks.Attachments.DragHint}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📎 " FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding FileName}"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    Padding="4,0"
                                                    FontSize="11"
                                                    Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                                    ToolTip="{DynamicResource Tasks.Attachments.Remove}"
                                                    IsEnabled="{Binding DataContext.Editor.CanManageAttachments, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Click="AttachmentRemove_Click"
                                                    Tag="{Binding Id}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Margin="0,10,0,0"
                            Padding="11,9"
                            Background="{DynamicResource {x:Static theme:MosaicTheme.DangerSoftBrushKey}}"
                            BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasGeneralError, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding Error}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"
                                   AutomationProperties.AutomationId="TaskError"/>
                    </Border>
                    <Border Margin="0,10,0,0"
                            Padding="11,9"
                            Background="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"
                            CornerRadius="8"
                            Visibility="{Binding HasMessage, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding Message}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"
                                   AutomationProperties.AutomationId="TaskMessage"/>
                    </Border>

                    <TextBlock Text="{Binding Editor.StateLabel}"
                               Margin="0,14,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"
                               Visibility="{Binding Editor.HasTask, Converter={StaticResource BoolVisibility}}"/>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="EditorActionBar"
                    Grid.Row="2"
                    Padding="14,12"
                    Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceMutedBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                    BorderThickness="0,1,0,0">
                <StackPanel>
                    <Border Margin="0,0,0,8"
                            Padding="9,6"
                            Background="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"
                            CornerRadius="7"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                            AutomationProperties.AutomationId="TaskBusy">
                        <TextBlock Text="{Binding BusyFeedback}"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"/>
                    </Border>

                    <TextBlock Text="{DynamicResource Tasks.Archived.ReadOnly}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Visibility="{Binding IsArchived, Converter={StaticResource BoolVisibility}}"/>
                    <Button Content="{DynamicResource Tasks.Save}"
                            Command="{Binding SaveCommand}"
                            MinWidth="{Binding TaskButtonMinWidth}"
                            MinHeight="{Binding TaskButtonMinHeight}"
                            Style="{DynamicResource {x:Static theme:MosaicTheme.AccentButtonKey}}"
                            ToolTip="{DynamicResource Tasks.SaveHint}"
                            AutomationProperties.AutomationId="SaveTask"/>
                    <TextBlock Text="{DynamicResource Tasks.SaveHint}"
                               Margin="0,5,0,0"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Editor.HasTask}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Content="{Binding ArchiveLabel}" Command="{Binding ArchiveCommand}"
                            Margin="0,9,0,0" MinHeight="{Binding TaskButtonMinHeight}"
                            Visibility="{Binding Editor.HasTask, Converter={StaticResource BoolVisibility}}"
                            Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                            AutomationProperties.AutomationId="ArchiveTask"/>
                    <Grid x:Name="EditorActionGrid"
                          Margin="0,9,0,0"
                          Visibility="{Binding Editor.HasTask, Converter={StaticResource BoolVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="7"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="7"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="EditorActionSecondRow" Height="0"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="ToggleButton"
                                Content="{Binding Editor.ToggleLabel}"
                                Command="{Binding ToggleCommand}"
                                MinWidth="{Binding TaskButtonMinWidth}"
                                MinHeight="{Binding TaskButtonMinHeight}"
                                Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                AutomationProperties.AutomationId="ToggleTask"/>
                        <Button x:Name="ReloadButton"
                                MinWidth="{Binding TaskButtonMinWidth}"
                                Grid.Column="2"
                                Content="{DynamicResource Tasks.Reload}"
                                Command="{Binding ReloadCommand}"
                                MinHeight="{Binding TaskButtonMinHeight}"
                                Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                AutomationProperties.AutomationId="ReloadTask"/>
                        <Button x:Name="DeleteButton"
                                Grid.Column="4"
                                Content="{DynamicResource Tasks.Delete}"
                                Command="{Binding DeleteCommand}"
                                MinWidth="{Binding TaskButtonMinWidth}"
                                MinHeight="{Binding TaskButtonMinHeight}"
                                Style="{DynamicResource {x:Static theme:MosaicTheme.DangerButtonKey}}"
                                AutomationProperties.AutomationId="DeleteTask"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
