<UserControl x:Class="Mosaic.Tasks.Wpf.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Mosaic.Presentation.Wpf;assembly=Mosaic.Presentation.Wpf"
             xmlns:views="clr-namespace:Mosaic.Tasks.Wpf.Views"
             ClipToBounds="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot"
          Margin="32,30,28,28"
          ClipToBounds="True"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="HeaderContentGapRow" Height="22"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HeaderTextColumn" Width="*"/>
                <ColumnDefinition x:Name="HeaderActionColumn" Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="HeaderActionRow" Height="0"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="HeaderText" MaxWidth="620" HorizontalAlignment="Left">
                <TextBlock Text="今天，先完成一件事"
                           Style="{DynamicResource {x:Static theme:MosaicTheme.HeaderTextKey}}"/>
                <TextBlock Text="收好杂念，把下一步放在眼前。"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
            </StackPanel>
            <Button x:Name="NewTaskButton"
                    MinWidth="{Binding TaskButtonMinWidth}"
                    MinHeight="{Binding TaskButtonMinHeight}"
                    Grid.Column="1"
                    Content="＋  新建任务"
                    Command="{Binding NewCommand}"
                    Style="{DynamicResource {x:Static theme:MosaicTheme.AccentButtonKey}}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="24,0,0,0"
                    AutomationProperties.AutomationId="NewTask"/>
        </Grid>

        <Grid x:Name="ContentGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TaskListColumn" Width="5*" MinWidth="300"/>
                <ColumnDefinition x:Name="ContentGapColumn" Width="24"/>
                <ColumnDefinition x:Name="TaskEditorColumn" Width="3*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TaskListRow" Height="*"/>
                <RowDefinition x:Name="ContentGapRow" Height="0"/>
                <RowDefinition x:Name="TaskEditorRow" Height="0"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TaskListPane" MinWidth="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="任务清单"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextPrimaryBrushKey}}"/>
                        <TextBlock Text="{Binding CountLabel}"
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              MinWidth="116"
                              IsEnabled="{Binding CanEdit}"
                              SelectedIndex="{Binding FilterIndex}"
                              AutomationProperties.AutomationId="TaskFilter">
                        <ComboBoxItem Content="全部任务"/>
                        <ComboBoxItem Content="未完成"/>
                        <ComboBoxItem Content="已完成"/>
                    </ComboBox>
                    <Button Grid.Column="2"
                            Content="刷新"
                            Command="{Binding LoadCommand}"
                            IsEnabled="{Binding CanRefresh}"
                            Margin="8,0,0,0"
                            Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"/>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,0,6,12"
                        Padding="11,9"
                        Background="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"
                        CornerRadius="8"
                        Visibility="{Binding ShowListMessage, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="{Binding Message}"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"/>
                </Border>

                <Grid Grid.Row="2">
                    <ListBox x:Name="TaskListBox"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEdit}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.AutomationId="TaskList"
                             AutomationProperties.Name="任务列表">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,6,10"/>
                                <Setter Property="MinHeight" Value="60"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding AccessibilityLabel}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="TaskRow"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="10"
                                                    Padding="17,15">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TaskRow" Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.SurfaceMutedBrushKey}}"/>
                                                    <Setter TargetName="TaskRow" Property="BorderBrush" Value="{DynamicResource {x:Static theme:MosaicTheme.ControlHoverBorderBrushKey}}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TaskRow" Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"/>
                                                    <Setter TargetName="TaskRow" Property="BorderBrush" Value="{DynamicResource {x:Static theme:MosaicTheme.FocusBrushKey}}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="TaskRow" Property="BorderBrush" Value="{DynamicResource {x:Static theme:MosaicTheme.FocusBrushKey}}"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="TaskRow" Property="Opacity" Value="0.72"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding CompletionGlyph}"
                                               FontSize="20"
                                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.FocusBrushKey}}"
                                               AutomationProperties.Name="{Binding CompletionLabel}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="15">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding CreatedLabel}"
                                                   Margin="0,7,0,0"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border x:Name="TaskEmptyOverlay"
                            Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}"
                            BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Panel.ZIndex="0"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsListEmpty, Converter={StaticResource BoolVisibility}}">
                        <StackPanel MaxWidth="340"
                                    Margin="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Border Width="52"
                                    Height="52"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"
                                    CornerRadius="26">
                                <TextBlock Text="✓"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="28"
                                           Foreground="{DynamicResource {x:Static theme:MosaicTheme.FocusBrushKey}}"/>
                            </Border>
                            <TextBlock Text="{Binding EmptyTitle}"
                                       Margin="0,16,0,7"
                                       HorizontalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding EmptyDescription}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="TaskLoadingOverlay"
                            Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}"
                            BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Panel.ZIndex="2"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="正在读取任务…"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="TaskErrorOverlay"
                            Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}"
                            BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Panel.ZIndex="1"
                            Visibility="{Binding HasListError, Converter={StaticResource BoolVisibility}}">
                        <StackPanel MaxWidth="340"
                                    Margin="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="任务列表加载失败"
                                       HorizontalAlignment="Center"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ListError}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"/>
                            <Button Content="重试"
                                    Command="{Binding LoadCommand}"
                                    IsEnabled="{Binding CanRetry}"
                                    HorizontalAlignment="Center"
                                    Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <views:TaskEditorView x:Name="TaskEditorPane" Grid.Column="2" MinWidth="0"/>
        </Grid>
    </Grid>
</UserControl>
