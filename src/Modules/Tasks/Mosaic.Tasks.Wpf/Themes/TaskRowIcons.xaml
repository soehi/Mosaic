<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Mosaic.Presentation.Wpf;assembly=Mosaic.Presentation.Wpf">
    <Style x:Key="TaskAttachmentBadge" TargetType="Border">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"/>
        <Setter Property="ToolTip" Value="{Binding AttachmentLabel}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding AttachmentLabel}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasAttachments}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TaskPaperclip" TargetType="Path">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Data" Value="M 20.2,11.1 L 11.7,19.6 A 5,5 0 0 1 4.6,12.5 L 13.1,4 A 3.3,3.3 0 0 1 17.8,8.7 L 9.3,17.2 A 1.7,1.7 0 0 1 6.9,14.8 L 14.7,7"/>
        <Setter Property="Stroke" Value="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>
</ResourceDictionary>
