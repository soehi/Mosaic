<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="clr-namespace:Mosaic.Presentation.Wpf;assembly=Mosaic.Presentation.Wpf" x:Class="Mosaic.Tasks.Wpf.Internal.TaskPeekView" x:ClassModifier="internal" AutomationProperties.AutomationId="TaskPeekView">
    <UserControl.Resources>
        <Style x:Key="PeekStatusGlyph" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasCustomColor}" Value="True">
                    <Setter Property="Stroke" Value="{Binding CustomColor}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PeekFilterButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource MosaicButtonFocusVisual}"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="MinWidth" Value="54"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.TextPrimaryBrushKey}}"/>
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}"/>
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.DisabledTextBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="ListPage">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Summary" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                <Border x:Name="Filters" Grid.Column="1" Margin="10,0,0,0" Padding="1" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceMutedBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}">
                    <StackPanel x:Name="FilterOptions" Orientation="Horizontal">
                        <RadioButton Tag="All" AutomationProperties.AutomationId="PeekFilterAll" Style="{StaticResource PeekFilterButton}" GroupName="PeekFilter" Checked="FilterClicked"/>
                        <RadioButton Tag="Open" AutomationProperties.AutomationId="PeekFilterOpen" Style="{StaticResource PeekFilterButton}" GroupName="PeekFilter" Checked="FilterClicked"/>
                        <RadioButton Tag="Completed" AutomationProperties.AutomationId="PeekFilterCompleted" Style="{StaticResource PeekFilterButton}" GroupName="PeekFilter" Checked="FilterClicked"/>
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel Grid.Row="1">
                <DockPanel x:Name="OperationFeedback" Visibility="Collapsed" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite">
                    <Button x:Name="DismissFeedback" DockPanel.Dock="Right" Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"/>
                    <TextBlock x:Name="OperationMessage" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="DetachFeedback" Visibility="Collapsed" Margin="0,0,0,8" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
            <Grid Grid.Row="2">
                <StackPanel x:Name="State" Margin="0,12">
                    <TextBlock x:Name="Feedback" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                    <Button x:Name="Retry" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"/>
                </StackPanel>
                <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Padding="0">
                    <StackPanel>
                        <ItemsControl x:Name="Rows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="TaskRow" Margin="{Binding Margin}" Background="Transparent" PreviewMouseLeftButtonDown="StartGesture" PreviewMouseMove="MoveGesture" PreviewMouseLeftButtonUp="EndGesture" LostMouseCapture="CaptureLost">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="CompleteButton" AutomationProperties.AutomationId="PeekComplete" Click="CompleteTask" Width="30" Padding="4" Margin="0,0,4,0" Visibility="{Binding CompletionVisibility}" IsEnabled="{Binding CanComplete}" AutomationProperties.Name="{Binding CompletionName}" ToolTip="{Binding CompletionName}" Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}">
                                            <Grid>
                                                <TextBlock Text="…" Visibility="{Binding BusyVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Path Visibility="{Binding GlyphVisibility}" Width="18" Height="18" Stretch="Uniform" Data="{Binding Geometry}" StrokeThickness="1.7" Style="{StaticResource PeekStatusGlyph}"/>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="TaskCard" Grid.Column="1" Click="OpenTask" ContextMenuOpening="OpenMenu" Padding="{Binding Padding}" BorderThickness="1" HorizontalContentAlignment="Stretch" Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}" BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip="{DynamicResource Tasks.Peek.ViewDetails}">
                                            <Button.ContextMenu>
                                                <ContextMenu/>
                                            </Button.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Style="{StaticResource PeekStatusGlyph}" Visibility="{Binding StaticStatusVisibility}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Data="{Binding Geometry}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        </Path>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="{Binding FontSize}" LineHeight="{Binding LineHeight}" LineStackingStrategy="BlockLineHeight" MaxHeight="{Binding MaximumTitleHeight}" Margin="10,0,8,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.Name="{Binding AccessibleName}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.TextPrimaryBrushKey}}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding Status}" Visibility="{Binding StatusVisibility}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="More" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        <ContentControl x:Name="DetailHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</UserControl>
