<UserControl x:Class="Mosaic.DesktopPresence.Wpf.PresencePopupView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Mosaic.Presentation.Wpf;assembly=Mosaic.Presentation.Wpf"
             FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" UseLayoutRounding="True"
             Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextPrimaryBrushKey}}">
    <Border x:Name="Frame" Margin="6" CornerRadius="12" BorderThickness="1" Padding="16"
            Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}"
            BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="HeaderFrame" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Presence.Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="×" FontSize="20" MinWidth="32" MinHeight="32" Padding="0" Margin="8,0,0,0"
                        Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}" Click="Dismiss"
                        ToolTip="{DynamicResource Presence.Dismiss}" AutomationProperties.Name="{DynamicResource Presence.Dismiss}"
                        AutomationProperties.AutomationId="PresenceDismiss"/>
            </Grid>
            <ContentControl x:Name="ContentHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Content="{DynamicResource Presence.Restore}" MinHeight="32" MinWidth="0" Padding="8,4" HorizontalAlignment="Left"
                            Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}" Click="Restore"
                            AutomationProperties.AutomationId="PresenceRestore"/>
                    <Button x:Name="MoreButton" Grid.Column="1" Content="⋯" FontSize="20" MinHeight="32" MinWidth="32" Padding="4,0"
                            ToolTip="{DynamicResource Presence.More}" AutomationProperties.Name="{DynamicResource Presence.More}"
                            Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}" Click="More"
                            AutomationProperties.AutomationId="PresenceMore">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MoreMenu">
                                <MenuItem Header="{DynamicResource Presence.Exit}" Click="Exit" AutomationProperties.AutomationId="PresenceExit"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>
                <TextBlock x:Name="DismissHint" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
