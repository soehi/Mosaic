<UserControl x:Class="Mosaic.Settings.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Mosaic.Presentation.Wpf;assembly=Mosaic.Presentation.Wpf"
             xmlns:local="clr-namespace:Mosaic.Settings.Wpf.Internal"
             ClipToBounds="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <local:SettingsSectionNameConverter x:Key="SectionName"/>
    </UserControl.Resources>

    <Grid Margin="32,30,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource Settings.Title}"
                       Style="{DynamicResource {x:Static theme:MosaicTheme.HeaderTextKey}}"/>
            <TextBlock Text="{DynamicResource Settings.Subtitle}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,22,0,0"
                Padding="16,12"
                Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceMutedBrushKey}}"
                BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Settings.Advanced}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <CheckBox Margin="12,0,0,0"
                          IsChecked="{Binding ShowAdvanced}"
                          VerticalAlignment="Center"
                          Content="{DynamicResource Settings.ShowAll}"
                          AutomationProperties.AutomationId="SettingsShowAdvanced"/>
                <Button Margin="18,0,0,0"
                        Content="{DynamicResource Settings.Discard}"
                        Command="{Binding DiscardCommand}"
                        Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"/>
                <Button Margin="8,0,0,0"
                        Content="{DynamicResource Settings.Save}"
                        Command="{Binding SaveCommand}"
                        Style="{DynamicResource {x:Static theme:MosaicTheme.AccentButtonKey}}"
                        AutomationProperties.AutomationId="SaveSettings"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="204"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                    HorizontalContentAlignment="Left"
                                    Margin="0,0,0,7"
                                    Padding="13,0"
                                    MinHeight="42">
                                <TextBlock Text="{Binding Converter={StaticResource SectionName}}"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="{DynamicResource Settings.ResetSection}"
                        Command="{Binding ResetSectionCommand}"
                        Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                        Margin="0,14,0,0"/>
                <Button Content="{DynamicResource Settings.ResetAll}"
                        Command="{Binding ResetAllCommand}"
                        Style="{DynamicResource {x:Static theme:MosaicTheme.DangerButtonKey}}"
                        Margin="0,8,0,0"/>
            </StackPanel>

            <Border Grid.Column="2"
                    Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">
                <Grid>
                    <Border Padding="18"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Settings.Loading}"
                                       HorizontalAlignment="Center"
                                       FontSize="15"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Padding="24,20,14,22"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Margin="0,0,0,16"
                                    Padding="12,10"
                                    Background="{DynamicResource {x:Static theme:MosaicTheme.DangerSoftBrushKey}}"
                                    BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Visibility="{Binding IsError, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="{Binding Message}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"/>
                            </Border>
                            <Border Margin="0,0,0,16"
                                    Padding="12,10"
                                    Background="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"
                                    CornerRadius="9"
                                    Visibility="{Binding HasMessage, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="{Binding Message}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"/>
                            </Border>
                            <ItemsControl ItemsSource="{Binding VisibleRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,14"
                                                Padding="16,14"
                                                Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceMutedBrushKey}}"
                                                BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Border Margin="0,0,6,0"
                                                                Padding="7,3"
                                                                Background="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"
                                                                CornerRadius="8"
                                                                Visibility="{Binding RequiresRestart, Converter={StaticResource BoolVisibility}}">
                                                            <TextBlock Text="{DynamicResource Settings.RequiresRestart}" FontSize="10"
                                                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"/>
                                                        </Border>
                                                        <Border Padding="7,3"
                                                                Background="{DynamicResource {x:Static theme:MosaicTheme.DangerSoftBrushKey}}"
                                                                CornerRadius="8"
                                                                Visibility="{Binding HasWarning, Converter={StaticResource BoolVisibility}}">
                                                            <TextBlock Text="{DynamicResource Settings.Risk}" FontSize="10"
                                                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding Description}"
                                                           Margin="0,5,0,0"
                                                           TextWrapping="Wrap"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                                                <TextBlock Text="{Binding Warning}"
                                                           Margin="0,5,0,0"
                                                           TextWrapping="Wrap"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"
                                                           Visibility="{Binding HasWarning, Converter={StaticResource BoolVisibility}}"/>
                                                <Grid Margin="0,13,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <CheckBox Content="{DynamicResource Settings.Enabled}"
                                                              IsChecked="{Binding BooleanValue}"
                                                              IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              MinHeight="34"
                                                              HorizontalAlignment="Left"
                                                              Visibility="{Binding IsBoolean, Converter={StaticResource BoolVisibility}}"/>
                                                    <ComboBox Grid.Row="0"
                                                              ItemsSource="{Binding Choices}"
                                                              SelectedValuePath="Value"
                                                              SelectedValue="{Binding ChoiceValue}"
                                                              IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              MinWidth="220"
                                                              MinHeight="40"
                                                              HorizontalAlignment="Left"
                                                              Visibility="{Binding IsEnum, Converter={StaticResource BoolVisibility}}"/>
                                                    <TextBox Grid.Row="0"
                                                             Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             MinHeight="42"
                                                             MaxHeight="150"
                                                             AcceptsReturn="{Binding IsProviderMap}"
                                                             TextWrapping="Wrap"
                                                             VerticalContentAlignment="Top"
                                                             Visibility="{Binding IsText, Converter={StaticResource BoolVisibility}}"/>
                                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Constraint}"
                                                                   FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Error}"
                                                                       Margin="0,0,12,0"
                                                                       FontSize="11"
                                                                       MaxWidth="320"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"/>
                                                                    <Button Content="{DynamicResource Settings.ResetRow}"
                                                                    Command="{Binding DataContext.ResetToDefaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                                                    MinHeight="34"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                                <Grid Margin="0,11,0,0" Visibility="Collapsed">
                                                    <TextBlock Text="{Binding Constraint}"
                                                               FontSize="10"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                                                    <TextBlock Text="{Binding Error}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"
                                                               HorizontalAlignment="Right"
                                                               MaxWidth="320"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding EmptyMessage}"
                                       Margin="0,24"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
