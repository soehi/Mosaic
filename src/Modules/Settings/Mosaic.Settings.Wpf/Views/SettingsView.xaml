<UserControl x:Class="Mosaic.Settings.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Mosaic.Presentation.Wpf;assembly=Mosaic.Presentation.Wpf"
             xmlns:local="clr-namespace:Mosaic.Settings.Wpf.Internal"
             Background="{DynamicResource {x:Static theme:MosaicTheme.CanvasBrushKey}}"
             Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextPrimaryBrushKey}}"
             FontSize="14" ClipToBounds="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <local:SettingsSectionNameConverter x:Key="SectionName"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolVisibility"/>
        <local:SettingOptionDisplayConverter x:Key="OptionDisplay"/>
        <local:SectionSelectedHighlightConverter x:Key="SectionSelected"/>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource MosaicButtonFocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.TextPrimaryBrushKey}}"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="SwitchFace" Padding="4" CornerRadius="7" Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Track" Width="36" Height="22" CornerRadius="11"
                                        Background="{DynamicResource {x:Static theme:MosaicTheme.DisabledSurfaceBrushKey}}"
                                        BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}" BorderThickness="1">
                                    <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left"
                                             Fill="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                                </Border>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.AccentButtonBackgroundBrushKey}}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource {x:Static theme:MosaicTheme.AccentButtonBackgroundBrushKey}}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource {x:Static theme:MosaicTheme.AccentButtonTextBrushKey}}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchFace" Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.SurfaceMutedBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SwitchFace" Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchFace" Property="Background" Value="Transparent"/>
                                <Setter TargetName="SwitchFace" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="BooleanEditor">
            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BooleanValue}"
                      HorizontalAlignment="Left" AutomationProperties.Name="{Binding DisplayName}">
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{DynamicResource Settings.Value.Off}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BooleanValue}" Value="True">
                                    <Setter Property="Text" Value="{DynamicResource Settings.Value.On}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </CheckBox>
        </DataTemplate>
        <DataTemplate x:Key="EnumEditor">
            <ComboBox ItemsSource="{Binding Choices}" SelectedValuePath="Value" SelectedValue="{Binding ChoiceValue}"
                      MinHeight="40" AutomationProperties.Name="{Binding DisplayName}">
                <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource OptionDisplay}}"/></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DataTemplate>
        <DataTemplate x:Key="IntegerEditor">
            <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" MinHeight="40"
                     MaxWidth="160" HorizontalAlignment="Left" MinWidth="120" AutomationProperties.Name="{Binding DisplayName}"/>
        </DataTemplate>
        <DataTemplate x:Key="TextEditor">
            <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" MinHeight="40"
                     MaxHeight="140" AcceptsReturn="{Binding IsProviderMap}" TextWrapping="Wrap"
                     AutomationProperties.Name="{Binding DisplayName}" ToolTip="{Binding TextHint}"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{DynamicResource Settings.Title}" Style="{DynamicResource {x:Static theme:MosaicTheme.HeaderTextKey}}"/>
            <TextBlock x:Name="SubtitleText" Text="{DynamicResource Settings.Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
        </StackPanel>
        <Border x:Name="ModeBar" Grid.Row="1" Padding="14,8" Margin="0,0,0,20" CornerRadius="10"
                Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceMutedBrushKey}}">
            <DockPanel LastChildFill="True">
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowAdvanced}"
                          IsEnabled="{Binding IsNotBusy}" Content="{DynamicResource Settings.Advanced}"
                          AutomationProperties.AutomationId="SettingsShowAdvanced"/>
                <TextBlock Text="{Binding ModeDescription}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                           FontSize="12" Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"
                            Visibility="{Binding HasSettingsSectionContent, Converter={StaticResource BoolVisibility}}">
                    <Separator Margin="8,0,8,12" Background="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"/>
                    <Button Content="{DynamicResource Settings.ResetSection}" Command="{Binding ResetSectionCommand}"
                            Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}" HorizontalContentAlignment="Left" MinHeight="40"/>
                    <Button Content="{DynamicResource Settings.ResetAll}" Command="{Binding ResetAllCommand}" MinHeight="40"
                            Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}" HorizontalContentAlignment="Left"
                            Foreground="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}" Margin="0,4,0,0"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="14,0" MinHeight="44">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Static theme:MosaicTheme.QuietButtonKey}}">
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource SectionSelected}" ConverterParameter="Selected">
                                                        <Binding/>
                                                        <Binding Path="DataContext.SelectedSection" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding Converter={StaticResource SectionName}}" FontWeight="SemiBold"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <Border Grid.Column="2" Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="20,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding VisibleCountLabel}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"
                                       Visibility="{Binding HasSettingsSectionContent, Converter={StaticResource BoolVisibility}}"/>
                            <TextBlock Text="{Binding SelectedSection, Converter={StaticResource SectionName}}" FontSize="17" FontWeight="SemiBold"/>
                        </DockPanel>
                    </Border>
                    <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" Padding="20,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasSettingsSectionContent, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding VisibleRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,14" BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ValueColumn" Width="250"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <StackPanel x:Name="SettingLabel" Margin="0,0,24,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Description}" Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <WrapPanel.Style>
                                                            <Style TargetType="WrapPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RequiresRestart}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasWarning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </WrapPanel.Style>
                                                        <Border Padding="6,2" Margin="0,0,6,0" CornerRadius="4"
                                                                Background="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"
                                                                Visibility="{Binding RequiresRestart, Converter={StaticResource BoolVisibility}}">
                                                            <TextBlock Text="{DynamicResource Settings.RequiresRestart}" FontSize="11"
                                                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"/>
                                                        </Border>
                                                        <Border Padding="6,2" CornerRadius="4"
                                                                Background="{DynamicResource {x:Static theme:MosaicTheme.DangerSoftBrushKey}}"
                                                                Visibility="{Binding HasWarning, Converter={StaticResource BoolVisibility}}">
                                                            <TextBlock Text="{DynamicResource Settings.Risk}" FontSize="11"
                                                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"/>
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <ContentControl x:Name="ValueEditor" Grid.Column="1" Content="{Binding}" HorizontalContentAlignment="Stretch"
                                                                IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource TextEditor}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource BooleanEditor}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEnum}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource EnumEditor}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsInteger}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource IntegerEditor}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                                <StackPanel x:Name="SettingDetails" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding PreviewStatus}" FontSize="12" Margin="0,0,0,6"
                                                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"
                                                               Visibility="{Binding HasPreviewStatus, Converter={StaticResource BoolVisibility}}"/>
                                                    <TextBlock Text="{Binding Warning}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                                                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"
                                                               Visibility="{Binding HasWarning, Converter={StaticResource BoolVisibility}}"/>
                                                    <TextBlock Text="{Binding Error}" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource Settings.DefaultValue}" FontSize="12" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                                                        <TextBlock Text="{Binding DefaultValueText}" FontSize="12" Margin="4,0,12,0" MaxWidth="250" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" ToolTip="{Binding DefaultValueText}"
                                                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                                                        <TextBlock Text="{Binding Constraint}" FontSize="12" Margin="0,0,12,0" TextWrapping="Wrap" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                                                        <Button Content="{DynamicResource Settings.ResetRow}" Command="{Binding DataContext.ResetToDefaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                                                MinHeight="28" Padding="8,2" FontSize="12"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter TargetName="ValueColumn" Property="Width" Value="0"/>
                                                <Setter TargetName="ValueEditor" Property="Grid.Column" Value="0"/>
                                                <Setter TargetName="ValueEditor" Property="Grid.Row" Value="1"/>
                                                <Setter TargetName="ValueEditor" Property="Margin" Value="0,10,0,0"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding EmptyMessage}" Margin="0,36" TextWrapping="Wrap" HorizontalAlignment="Center"
                                       Visibility="{Binding HasVisibleRows, Converter={StaticResource InverseBoolVisibility}}"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <ContentControl Grid.Row="1" Content="{Binding SelectedPageView.View}"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Visibility="{Binding HasSelectedPage, Converter={StaticResource BoolVisibility}}"/>
                    <Border Grid.RowSpan="2" Panel.ZIndex="2" Padding="24"
                            Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{DynamicResource Settings.Loading}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="SettingsActionBar" Grid.Row="3" Margin="0,16,0,0" Padding="16,12" CornerRadius="10"
                Visibility="{Binding ShowActionBar, Converter={StaticResource BoolVisibility}}"
                Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}"
                BorderThickness="1" BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button Content="{DynamicResource Settings.Discard}" Command="{Binding DiscardCommand}" MinHeight="40"
                            Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"/>
                    <Button Content="{DynamicResource Settings.Save}" Command="{Binding SaveCommand}" MinHeight="40" MinWidth="112" Margin="8,0,0,0"
                            Style="{DynamicResource {x:Static theme:MosaicTheme.AccentButtonKey}}" ToolTip="Ctrl+S"
                            AutomationProperties.AutomationId="SaveSettings"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ChangesLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Message}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.DangerBrushKey}}"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar Height="3" IsIndeterminate="True" Margin="0,5,0,0" MaxWidth="180" HorizontalAlignment="Left" Width="180"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>



