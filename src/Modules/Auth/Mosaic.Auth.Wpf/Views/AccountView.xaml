<UserControl x:Class="Mosaic.Auth.Wpf.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Mosaic.Presentation.Wpf;assembly=Mosaic.Presentation.Wpf"
             xmlns:internal="clr-namespace:Mosaic.Auth.Wpf.Internal"
             Background="{DynamicResource {x:Static theme:MosaicTheme.CanvasBrushKey}}"
             Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextPrimaryBrushKey}}"
             FontSize="14" ClipToBounds="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <internal:LocalDateTimeConverter x:Key="LocalDateTime"/>
        <internal:CurrentSessionTagConverter x:Key="CurrentToTag"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static theme:MosaicTheme.BorderBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.SurfaceMutedBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.TextPrimaryBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static theme:MosaicTheme.ControlHoverBorderBrushKey}}"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldPassword" TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Static theme:MosaicTheme.QuietButtonKey}}">
            <Setter Property="Margin" Value="0,0,14,8"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"/>
        </Style>
        <Style x:Key="MessageBar" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static theme:MosaicTheme.AccentBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static theme:MosaicTheme.DangerSoftBrushKey}}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static theme:MosaicTheme.DangerBorderBrushKey}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  AutomationProperties.AutomationId="AccountPage">
        <StackPanel Margin="32,28,32,40" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource Auth.Title}"
                       Visibility="{Binding ShowStartPage, Converter={StaticResource BoolVisibility}}"
                       Style="{DynamicResource {x:Static theme:MosaicTheme.HeaderTextKey}}"/>
            <TextBlock Text="{DynamicResource Auth.Subtitle}"
                       Visibility="{Binding ShowStartPage, Converter={StaticResource BoolVisibility}}"
                       TextWrapping="Wrap" Margin="0,6,0,20"
                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>

            <Border Style="{StaticResource MessageBar}"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                           Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextPrimaryBrushKey}}"/>
            </Border>

            <StackPanel Visibility="{Binding ShowStartPage, Converter={StaticResource BoolVisibility}}">
            <!-- Signed out: optional sign-in. Nothing here runs until the user acts. -->
            <StackPanel Visibility="{Binding ShowLoginCard, Converter={StaticResource BoolVisibility}}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding ModeTitle}"
                                   Style="{DynamicResource {x:Static theme:MosaicTheme.BodyTextKey}}"
                                   FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ModeDescription}" TextWrapping="Wrap" Margin="0,6,0,14"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>

                        <TextBlock Text="{Binding ServerDisplay}" TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,12"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>

                        <StackPanel Visibility="{Binding ShowServerPanel, Converter={StaticResource BoolVisibility}}"
                                    Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Auth.Server.Label}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ServerInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}"
                                     FontSize="16"
                                     AutomationProperties.AutomationId="ServerUrlInput"
                                     AutomationProperties.Name="{DynamicResource Auth.Server.Label}"/>
                            <TextBlock Text="{DynamicResource Auth.Server.Hint}" TextWrapping="Wrap" FontSize="12"
                                       Margin="0,0,0,10"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource Auth.Server.Save}" Command="{Binding SaveServerCommand}"
                                        Style="{DynamicResource {x:Static theme:MosaicTheme.AccentButtonKey}}"
                                        MinHeight="36"/>
                                <Button Content="{DynamicResource Auth.Server.Cancel}" Command="{Binding ToggleServerPanelCommand}"
                                        Style="{StaticResource LinkButton}" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Login: the account-choice screen. Registration, the email+password
                             form and password reset live entirely in the browser (device flow);
                             the desktop offers exactly four entries and nothing runs until the
                             user acts. -->
                        <StackPanel Visibility="{Binding IsLoginMode, Converter={StaticResource BoolVisibility}}"
                                    AutomationProperties.AutomationId="AccountChoice"
                                    AutomationProperties.Name="{DynamicResource Auth.Choice.Title}">
                            <Button Content="{DynamicResource Auth.Login.Browser}" Command="{Binding StartDeviceCommand}"
                                    Style="{DynamicResource {x:Static theme:MosaicTheme.AccentButtonKey}}"
                                    HorizontalAlignment="Left" MinWidth="240" MinHeight="38" Margin="0,0,0,10"
                                    AutomationProperties.AutomationId="BrowserLoginButton"/>
                            <Button Content="{DynamicResource Auth.Server.Change}" Command="{Binding ToggleServerPanelCommand}"
                                    Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                    HorizontalAlignment="Left" MinWidth="240" MinHeight="38" Margin="0,0,0,10"
                                    AutomationProperties.AutomationId="ServerPanelButton"/>
                            <Button Content="{DynamicResource Auth.Login.Offline}" Command="{Binding UseOfflineCommand}"
                                    Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                    HorizontalAlignment="Left" MinWidth="240" MinHeight="38" Margin="0,0,0,10"
                                    AutomationProperties.AutomationId="OfflineButton"/>
                            <Button Content="{DynamicResource Auth.Login.Forgot}" Command="{Binding ShowForgotCommand}"
                                    Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                    HorizontalAlignment="Left" MinWidth="240" MinHeight="38"
                                    AutomationProperties.AutomationId="ForgotButton"/>
                        </StackPanel>

                        <!-- Device flow: browser or phone confirmation -->
                        <StackPanel Visibility="{Binding IsDeviceMode, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{DynamicResource Auth.Device.CodeLabel}" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding DeviceCode}" FontSize="34" FontWeight="SemiBold"
                                       FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                       Margin="0,0,0,10"
                                       AutomationProperties.AutomationId="DeviceCode"/>
                            <TextBlock Text="{Binding DeviceUri}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                            <TextBlock Text="{Binding DeviceStatus}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"/>
                            <TextBlock Text="{Binding DeviceExpiryText}" FontSize="12" Margin="0,0,0,14"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"
                                       Visibility="{Binding IsDeviceRunning, Converter={StaticResource BoolVisibility}}"/>
                            <WrapPanel>
                                <Button Content="{DynamicResource Auth.Device.Copy}" Command="{Binding CopyDeviceCodeCommand}"
                                        Style="{StaticResource LinkButton}" AutomationProperties.AutomationId="CopyDeviceCodeButton"/>
                                <Button Content="{DynamicResource Auth.Device.Open}" Command="{Binding OpenDeviceUriCommand}"
                                        Style="{StaticResource LinkButton}"/>
                                <Button Content="{DynamicResource Auth.Device.Cancel}" Command="{Binding CancelDeviceCommand}"
                                        Style="{StaticResource LinkButton}" AutomationProperties.AutomationId="CancelDeviceButton"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Offline choice -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding ShowOfflineNote, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Auth.Offline.Title}"
                               Style="{DynamicResource {x:Static theme:MosaicTheme.BodyTextKey}}"
                               FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Auth.Offline.Description}" TextWrapping="Wrap" Margin="0,6,0,14"
                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                    <Button Content="{DynamicResource Auth.Offline.Connect}" Command="{Binding ConnectCommand}"
                            Style="{DynamicResource {x:Static theme:MosaicTheme.AccentButtonKey}}"
                            HorizontalAlignment="Left" MinHeight="38"/>
                </StackPanel>
            </Border>

            </StackPanel>
            <!-- Signed-in account details: account, sync and sessions. -->
            <StackPanel Visibility="{Binding ShowAccountSettings, Converter={StaticResource BoolVisibility}}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="24"
                                Background="{DynamicResource {x:Static theme:MosaicTheme.AccentSoftBrushKey}}"
                                Margin="0,0,14,0">
                            <TextBlock Text="{Binding AccountInitials}" FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.AccentTextBrushKey}}"/>
                        </Border>
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Auth.Account.Logout}"
                                Command="{Binding LogoutCommand}"
                                Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                VerticalAlignment="Center" MinHeight="36"
                                AutomationProperties.AutomationId="AccountLogoutButton"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding AccountEmail}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding AccountName}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                            <TextBlock Text="{Binding ServerDisplay}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Auth.Sync.Title}"
                                   Style="{DynamicResource {x:Static theme:MosaicTheme.BodyTextKey}}"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <CheckBox Content="{DynamicResource Auth.Sync.Enabled}" IsChecked="{Binding SyncEnabled}"
                                  MinHeight="36" AutomationProperties.AutomationId="SyncEnabledToggle"/>
                        <TextBlock Text="{DynamicResource Auth.Sync.Enabled.Description}" TextWrapping="Wrap"
                                   FontSize="12" Margin="0,0,0,10"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                        <CheckBox Content="{DynamicResource Auth.Sync.IncludeSettings}" IsChecked="{Binding IncludeSettings}"
                                  MinHeight="36" AutomationProperties.AutomationId="SyncIncludeSettingsToggle"/>
                        <TextBlock Text="{DynamicResource Auth.Sync.IncludeSettings.Description}" TextWrapping="Wrap"
                                   FontSize="12" Margin="0,0,0,14"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>

                        <TextBlock Text="{Binding SnapshotSummary}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextSecondaryBrushKey}}"/>
                        <TextBlock Text="{Binding RestoreSummary}" TextWrapping="Wrap" Margin="0,0,0,14"
                                   FontSize="13"
                                   Visibility="{Binding HasRestore, Converter={StaticResource BoolVisibility}}"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>

                        <CheckBox Content="{DynamicResource Auth.Sync.IncludeOnUpload}" IsChecked="{Binding IncludeOnUpload}"
                                  MinHeight="32" Margin="0,0,0,10"
                                  AutomationProperties.AutomationId="SyncIncludeOnUploadToggle"/>
                        <WrapPanel>
                            <Button Content="{DynamicResource Auth.Sync.Upload}" Command="{Binding UploadCommand}"
                                    Style="{DynamicResource {x:Static theme:MosaicTheme.AccentButtonKey}}"
                                    MinWidth="120" MinHeight="38" Margin="0,0,10,8"
                                    AutomationProperties.AutomationId="UploadBackupButton"/>
                            <Button Content="{DynamicResource Auth.Sync.Download}" Command="{Binding DownloadCommand}"
                                    Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                    MinWidth="120" MinHeight="38" Margin="0,0,10,8"
                                    AutomationProperties.AutomationId="DownloadBackupButton"/>
                            <Button Content="{DynamicResource Auth.Sync.Refresh}" Command="{Binding RefreshLatestCommand}"
                                    Style="{StaticResource LinkButton}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Auth.Sessions.Title}"
                                   Style="{DynamicResource {x:Static theme:MosaicTheme.BodyTextKey}}"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <StackPanel Visibility="{Binding ShowSessionsLoading, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{DynamicResource Auth.Sessions.Loading}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowSessionList, Converter={StaticResource BoolVisibility}}">
                            <ItemsControl ItemsSource="{Binding Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="6"
                                                Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding DeviceLabel, TargetNullValue=未知设备}"/><Run
                                                            Text="{Binding Current, Converter={StaticResource CurrentToTag}}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}">
                                                        <Run Text="{Binding Platform, TargetNullValue=未知平台}"/><Run Text=" · 最近活跃："/><Run
                                                            Text="{Binding LastSeenAtUtc, Converter={StaticResource LocalDateTime}}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{DynamicResource Auth.Sessions.Revoke}"
                                                        Command="{Binding DataContext.RevokeSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Id}"
                                                        Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                                        MinHeight="32" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="{DynamicResource Auth.Sessions.Refresh}" Command="{Binding RefreshSessionsCommand}"
                                    Style="{StaticResource LinkButton}" Margin="0,0,12,0"/>
                            <Button Content="{DynamicResource Auth.Sessions.RevokeOthers}" Command="{Binding RevokeAllSessionsCommand}"
                                    Style="{StaticResource LinkButton}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Auth.Delete.Title}"
                                   Style="{DynamicResource {x:Static theme:MosaicTheme.BodyTextKey}}"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource Auth.Delete.Description}" TextWrapping="Wrap"
                                   FontSize="12" Margin="0,0,0,12"
                                   Foreground="{DynamicResource {x:Static theme:MosaicTheme.TextMutedBrushKey}}"/>
                        <Button Content="{DynamicResource Auth.Delete.Action}" Command="{Binding ShowDeleteDialogCommand}"
                                Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                MinWidth="120" MinHeight="38" HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="DeleteAccountButton"/>
                        <Border Visibility="{Binding DeleteDialogVisible, Converter={StaticResource BoolVisibility}}"
                                Margin="0,12,0,0" Padding="14" CornerRadius="6"
                                Background="{DynamicResource {x:Static theme:MosaicTheme.SurfaceBrushKey}}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Auth.Delete.Verify}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <RadioButton Content="{DynamicResource Auth.Delete.UsePassword}" IsChecked="{Binding DeleteUsePassword, Mode=TwoWay}"
                                                 GroupName="DeleteMethod" MinHeight="32" Margin="0,0,16,0"/>
                                    <RadioButton Content="{DynamicResource Auth.Delete.UseCode}" IsChecked="{Binding DeleteUseCode, Mode=TwoWay}"
                                                 GroupName="DeleteMethod" MinHeight="32"/>
                                </WrapPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding DeleteCredential, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="38" Margin="0,0,10,0"
                                             AutomationProperties.AutomationId="DeleteCredentialInput"/>
                                    <Button Grid.Column="1" Content="{Binding SendCodeLabel}" Command="{Binding SendDeleteCodeCommand}"
                                            Visibility="{Binding DeleteUseCode, Converter={StaticResource BoolVisibility}}"
                                            Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                            MinHeight="38" MinWidth="120"
                                            AutomationProperties.AutomationId="SendDeleteCodeButton"/>
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="{DynamicResource Auth.Delete.Confirm}" Command="{Binding ConfirmDeleteCommand}"
                                            Style="{DynamicResource {x:Static theme:MosaicTheme.AccentButtonKey}}"
                                            MinWidth="120" MinHeight="38" Margin="0,0,10,0"
                                            AutomationProperties.AutomationId="ConfirmDeleteAccountButton"/>
                                    <Button Content="{DynamicResource Auth.Delete.Cancel}" Command="{Binding CancelDeleteCommand}"
                                            Style="{DynamicResource {x:Static theme:MosaicTheme.QuietButtonKey}}"
                                            MinWidth="90" MinHeight="38"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
