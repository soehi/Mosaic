<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="Auth.Navigation">账户</sys:String>
    <sys:String x:Key="Auth.Title">账户与备份</sys:String>
    <sys:String x:Key="Auth.Subtitle">登录后可把任务与可移植设置备份到服务器，并在其他设备上恢复。不登录也可以完全离线使用，本机数据不受影响。</sys:String>

    <sys:String x:Key="Auth.SignedOut.Title">登录账户</sys:String>
    <sys:String x:Key="Auth.SignedOut.Description">登录后可备份任务并在其他设备上恢复；不登录也可以完全离线使用。</sys:String>
    <sys:String x:Key="Auth.Choice.Title">选择如何开始</sys:String>
    <sys:String x:Key="Auth.Choice.Description">登录后可备份任务并在其他设备上恢复；不登录也可以完全离线使用。</sys:String>
    <sys:String x:Key="Auth.Server.Label">服务器地址</sys:String>
    <sys:String x:Key="Auth.Server.Hint">默认使用 https://mosaic.bansonic.top（我们部署的服务器），也可以改为其他 HTTPS 自建服务器；留空则本机不连接任何服务器。</sys:String>
    <sys:String x:Key="Auth.Server.None">尚未连接服务器</sys:String>
    <sys:String x:Key="Auth.Server.Current">当前服务器：{0}</sys:String>
    <sys:String x:Key="Auth.Server.Change">连接其他自建服务器</sys:String>
    <sys:String x:Key="Auth.Server.Save">保存服务器</sys:String>
    <sys:String x:Key="Auth.Server.Cancel">取消</sys:String>
    <sys:String x:Key="Auth.Server.Saved">服务器地址已保存。</sys:String>

    <sys:String x:Key="Auth.Code.Send">发送验证码</sys:String>
    <sys:String x:Key="Auth.Code.Resend">重新发送（{0} 秒）</sys:String>
    <sys:String x:Key="Auth.Code.Sent">验证码已发送，请查收邮箱。</sys:String>

    <sys:String x:Key="Auth.Login.Success">登录成功。</sys:String>
    <sys:String x:Key="Auth.Login.Browser">在浏览器中登录</sys:String>
    <sys:String x:Key="Auth.Login.Offline">不连接服务器，离线使用</sys:String>
    <sys:String x:Key="Auth.Login.Forgot">忘记密码</sys:String>
    <sys:String x:Key="Auth.Forgot.Opened">已在浏览器中打开密码找回页面，请按页面提示操作。</sys:String>

    <sys:String x:Key="Auth.Device.Title">在浏览器中登录</sys:String>
    <sys:String x:Key="Auth.Device.Description">在浏览器或手机上打开下面的地址，输入授权码完成确认。</sys:String>
    <sys:String x:Key="Auth.Device.CodeLabel">授权码</sys:String>
    <sys:String x:Key="Auth.Device.Waiting">等待浏览器确认…</sys:String>
    <sys:String x:Key="Auth.Device.Expires">授权码剩余有效时间：{0} 秒</sys:String>
    <sys:String x:Key="Auth.Device.Approved">已在浏览器中确认，登录成功。</sys:String>
    <sys:String x:Key="Auth.Device.Denied">已在浏览器中拒绝本次登录。</sys:String>
    <sys:String x:Key="Auth.Device.Expired">授权码已过期，请重新获取。</sys:String>
    <sys:String x:Key="Auth.Device.Copy">复制授权码</sys:String>
    <sys:String x:Key="Auth.Device.Copied">授权码已复制。</sys:String>
    <sys:String x:Key="Auth.Device.CopyFailed">无法复制授权码，请手动输入。</sys:String>
    <sys:String x:Key="Auth.Device.Open">打开浏览器</sys:String>
    <sys:String x:Key="Auth.Device.OpenFailed">无法打开浏览器，请手动访问上方地址。</sys:String>
    <sys:String x:Key="Auth.Device.Cancel">取消</sys:String>

    <sys:String x:Key="Auth.Offline.Title">已选择离线使用</sys:String>
    <sys:String x:Key="Auth.Offline.Description">所有数据仍保存在本机。需要备份时随时可以连接服务器。</sys:String>
    <sys:String x:Key="Auth.Offline.Connect">连接服务器</sys:String>

    <sys:String x:Key="Auth.Account.Logout">退出登录</sys:String>
    <sys:String x:Key="Auth.Logout.Confirm">退出后本机保存的登录凭据会被清除，任务数据仍保留在本机。</sys:String>
    <sys:String x:Key="Auth.Logout.Done">已退出登录。</sys:String>

    <sys:String x:Key="Auth.Sync.Title">账号备份</sys:String>
    <sys:String x:Key="Auth.Sync.Enabled">启用账号备份</sys:String>
    <sys:String x:Key="Auth.Sync.Enabled.Description">关闭后不再上传或下载备份，任务与设置继续在本机使用。</sys:String>
    <sys:String x:Key="Auth.Sync.IncludeSettings">同时备份可移植设置</sys:String>
    <sys:String x:Key="Auth.Sync.IncludeSettings.Description">仅包含主题、语言与文案偏好；不同步窗口位置、驻留、存储路径与登录凭据。</sys:String>
    <sys:String x:Key="Auth.Sync.IncludeOnUpload">本次上传包含设置</sys:String>
    <sys:String x:Key="Auth.Sync.Upload">上传备份</sys:String>
    <sys:String x:Key="Auth.Sync.Download">从备份恢复</sys:String>
    <sys:String x:Key="Auth.Sync.Refresh">刷新服务器备份</sys:String>
    <sys:String x:Key="Auth.Sync.None">服务器上还没有备份。</sys:String>
    <sys:String x:Key="Auth.Sync.Latest">最近备份：{0} · {1} 项 · {2}</sys:String>
    <sys:String x:Key="Auth.Sync.LastRestore">上次恢复：{0} 个任务，{1} 项设置</sys:String>
    <sys:String x:Key="Auth.Sync.Uploaded">备份已上传：{0} 个任务，{1} 项设置。</sys:String>
    <sys:String x:Key="Auth.Sync.Restored">已从备份恢复：{0} 个任务，{1} 项设置。</sys:String>
    <sys:String x:Key="Auth.Sync.Confirm.Title">覆盖本机任务</sys:String>
    <sys:String x:Key="Auth.Sync.Confirm.Message">从服务器下载备份会替换本机全部任务，并可能覆盖可移植设置，且无法撤销。是否继续？</sys:String>

    <sys:String x:Key="Auth.Validation.Email">请输入有效的邮箱地址。</sys:String>
    <sys:String x:Key="Auth.Validation.Password">密码需为 10–256 个字符。</sys:String>
    <sys:String x:Key="Auth.Validation.Code">请输入 6 位数字验证码。</sys:String>

    <sys:String x:Key="Auth.Error.Unknown">操作未完成，请稍后再试。</sys:String>
    <sys:String x:Key="Auth.Error.ServerRequired">请先填写服务器地址。</sys:String>
    <sys:String x:Key="Auth.Error.ServerUntrusted">服务器地址必须使用 HTTPS。</sys:String>
    <sys:String x:Key="Auth.Error.Network">无法连接服务器，请检查网络与服务器地址。</sys:String>
    <sys:String x:Key="Auth.Error.InvalidCredentials">邮箱或密码不正确。</sys:String>
    <sys:String x:Key="Auth.Error.EmailTaken">该邮箱已注册。</sys:String>
    <sys:String x:Key="Auth.Error.CodeInvalid">验证码不正确。</sys:String>
    <sys:String x:Key="Auth.Error.CodeExpired">验证码已过期，请重新获取。</sys:String>
    <sys:String x:Key="Auth.Error.RateLimited">请求过于频繁，请稍后再试。</sys:String>
    <sys:String x:Key="Auth.Error.RegistrationClosed">服务器当前未开放注册。</sys:String>
    <sys:String x:Key="Auth.Error.PasswordTooWeak">密码强度不足，请使用至少 10 个字符。</sys:String>
    <sys:String x:Key="Auth.Error.TokenExpired">登录状态已过期，请重新登录。</sys:String>
    <sys:String x:Key="Auth.Error.TokenInvalid">登录状态无效，请重新登录。</sys:String>
    <sys:String x:Key="Auth.Error.ReauthRequired">需要重新验证身份后才能继续。</sys:String>
    <sys:String x:Key="Auth.Error.SessionRevoked">会话已被撤销，请重新登录。</sys:String>
    <sys:String x:Key="Auth.Error.DeviceCodeInvalid">设备授权码无效或已过期。</sys:String>
    <sys:String x:Key="Auth.Error.DeviceFlowNotStarted">当前没有等待确认的设备授权。</sys:String>
    <sys:String x:Key="Auth.Error.SecretsUnavailable">无法访问本机凭据存储。</sys:String>
    <sys:String x:Key="Auth.Error.SyncDisabled">账号备份已在设置中关闭。</sys:String>
    <sys:String x:Key="Auth.Error.NotSignedIn">尚未登录服务器。</sys:String>
    <sys:String x:Key="Auth.Error.SnapshotInvalid">服务器返回的备份内容无效。</sys:String>
    <sys:String x:Key="Auth.Error.Unavailable">模块当前不可用，请稍后再试。</sys:String>
    <sys:String x:Key="Auth.Error.Canceled">操作已取消。</sys:String>
    <sys:String x:Key="Auth.Error.Validation">输入内容无效，请检查后重试。</sys:String>
    <sys:String x:Key="Auth.Sessions.Title">已登录会话</sys:String>
    <sys:String x:Key="Auth.Sessions.Loading">正在加载会话…</sys:String>
    <sys:String x:Key="Auth.Sessions.CurrentTag">（本设备）</sys:String>
    <sys:String x:Key="Auth.Sessions.Revoke">撤销</sys:String>
    <sys:String x:Key="Auth.Sessions.Revoked">会话已撤销。</sys:String>
    <sys:String x:Key="Auth.Sessions.Refresh">刷新会话</sys:String>
    <sys:String x:Key="Auth.Sessions.RevokeOthers">登出其他设备</sys:String>
    <sys:String x:Key="Auth.Sessions.RevokeOthers.Title">登出其他设备</sys:String>
    <sys:String x:Key="Auth.Sessions.RevokeOthers.Message">除当前设备外，其他所有设备都会被登出，需要重新登录。是否继续？</sys:String>
    <sys:String x:Key="Auth.Sessions.RevokeOthers.Done">其他会话已撤销。</sys:String>

    <sys:String x:Key="Auth.Delete.Title">删除账号</sys:String>
    <sys:String x:Key="Auth.Delete.Description">永久删除账号及云端保存的全部备份；本机数据保留。</sys:String>
    <sys:String x:Key="Auth.Delete.Action">删除账号…</sys:String>
    <sys:String x:Key="Auth.Delete.Verify">此操作无法撤销。请使用账户密码或新获取的邮箱验证码确认。</sys:String>
    <sys:String x:Key="Auth.Delete.UsePassword">密码</sys:String>
    <sys:String x:Key="Auth.Delete.UseCode">邮箱验证码</sys:String>
    <sys:String x:Key="Auth.Delete.PasswordLabel">账户密码</sys:String>
    <sys:String x:Key="Auth.Delete.CodeLabel">邮箱验证码</sys:String>
    <sys:String x:Key="Auth.Delete.PasswordPlaceholder">输入当前账户密码</sys:String>
    <sys:String x:Key="Auth.Delete.CodePlaceholder">输入收到的 6 位验证码</sys:String>
    <sys:String x:Key="Auth.Delete.Confirm">永久删除</sys:String>
    <sys:String x:Key="Auth.Delete.Cancel">取消</sys:String>
    <sys:String x:Key="Auth.Delete.Confirm.Title">永久删除账号</sys:String>
    <sys:String x:Key="Auth.Delete.Confirm.Message">账号与云端全部数据将被永久删除且无法恢复，本机数据保留。是否继续？</sys:String>
    <sys:String x:Key="Auth.Delete.Done">账号已删除。</sys:String>
</ResourceDictionary>
