<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="Desktop.Startup.Title">Mosaic · 启动</sys:String>
    <sys:String x:Key="Desktop.Startup.Preparing">正在准备本机工作空间…</sys:String>
    <sys:String x:Key="Desktop.Startup.FailedTitle">Mosaic · 无法启动</sys:String>
    <sys:String x:Key="Desktop.Startup.FixConfiguration">修正配置后重新启动。</sys:String>
    <sys:String x:Key="Desktop.Startup.Failed">本机工作空间启动失败。请检查数据目录权限或查看 Logs 中的诊断记录后重试。</sys:String>
    <sys:String x:Key="Desktop.Fatal.Message">Mosaic 遇到未预期的错误，将受控关闭。请重新启动并确认最近的保存结果。</sys:String>
    <sys:String x:Key="Desktop.Shutdown.Pending">仍在等待已接受的操作完成。选择“是”继续等待；选择“否”强制退出（保存结果可能未知，重启后请确认）。</sys:String>
    <sys:String x:Key="Desktop.Shutdown.Title">正在关闭 Mosaic</sys:String>
</ResourceDictionary>
