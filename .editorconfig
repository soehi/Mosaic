root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yaml,yml}]
indent_size = 2

[tests/**/*.cs]
# Lifecycle and cancellation tests deliberately control their own cancellation.
dotnet_diagnostic.xUnit1051.severity = suggestion
